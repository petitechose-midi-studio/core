# UX workflow: exercise every top-level view as a roundtrip from Macro.
# Purpose: catch delayed reactive fan-out and NotificationQueue overflow after
# settling in Sequencer, Project, and Device Settings.
# Expect: capture_changed:macro_initial=sequencer_open, capture_match:macro_initial=macro_after_sequencer, capture_changed:macro_initial=project_open, capture_match:macro_initial=macro_after_project, capture_changed:macro_initial=device_settings_open, capture_match:macro_initial=macro_final

0 tick
500 capture screen macro_initial

# Macro -> Sequencer -> settle -> Macro.
700 button LEFT_TOP down
780 tick
860 encoder NAV 1
940 button LEFT_TOP up
1240 tick
1440 capture screen sequencer_open
8940 tick

# In Sequencer a short LEFT_TOP belongs to local musical selection. Hold it to
# make the global View Selector explicit, then return to Macro with NAV.
9040 button LEFT_TOP down
10100 tick
10180 encoder NAV -1
10260 button LEFT_TOP up
10560 tick
10760 capture screen macro_after_sequencer

# Macro -> Project -> settle -> Macro.
10860 button LEFT_TOP down
10940 tick
11020 encoder NAV 1
11100 encoder NAV 1
11180 button LEFT_TOP up
11480 tick
11680 capture screen project_open
19180 tick
19280 button LEFT_TOP down
19360 tick
19440 encoder NAV -1
19520 encoder NAV -1
19600 button LEFT_TOP up
19900 tick
20100 capture screen macro_after_project

# Macro -> Device Settings -> settle -> Macro.
20200 button LEFT_TOP down
20280 tick
20360 encoder NAV 1
20440 encoder NAV 1
20520 encoder NAV 1
20600 button LEFT_TOP up
20900 tick
21100 capture screen device_settings_open
28600 tick
28700 button LEFT_TOP down
28780 tick
28860 encoder NAV -1
28940 encoder NAV -1
29020 encoder NAV -1
29100 button LEFT_TOP up
29400 tick
29600 capture screen macro_final
