# UX workflow: route global navigation through the View Selector.
# Purpose: validates selector hold behavior, Sequencer settings affordance, and
# Global Settings access as selector items/actions rather than hidden long press.

0 capture screen boot

# Hold LEFT_TOP to keep the selector visible while navigating.
100 button LEFT_TOP down
180 tick
220 capture screen selector_open

# Sequencer item exposes the settings gear action in the bottom strip.
300 encoder NAV 1
380 capture screen sequencer_item_with_settings
450 tap BOTTOM_LEFT 60
560 button LEFT_TOP up
700 capture screen sequencer_settings_open
820 tap LEFT_TOP 60
980 capture screen back_to_selector_from_sequencer_settings

# Global Settings is now an explicit selector item.
1100 encoder NAV 1
1180 capture screen global_settings_item
1250 button LEFT_TOP up
1400 capture screen global_settings_open
1520 tap LEFT_TOP 60
1680 capture screen back_to_selector_from_global_settings
