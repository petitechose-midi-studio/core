# UX workflow: edit a pattern quick control, then undo and redo it through the
# held LEFT_CENTER history layer.
# Purpose: validates Quick Controls history entry creation and global
# undo/redo routing while the Quick Controls layer is physically held.
# Expect: capture_match:sequencer_ready=undo_layer_closed, capture_match:length_applied=redo_layer_closed

0 scenario sequencer
50 capture screen sequencer_ready

# Hold LEFT_CENTER, focus Length, edit it, and release to apply.
150 button LEFT_CENTER down
300 capture screen quick_controls_open
400 encoder NAV -1
500 encoder OPT 0.20
650 capture screen length_adjusted
750 button LEFT_CENTER up
950 capture screen length_applied

# Hold LEFT_CENTER again and undo from the transient history layer.
1050 button LEFT_CENTER down
2050 tick
2100 capture screen undo_layer
2150 tap LEFT_TOP 60
2300 capture screen length_undone
2400 button LEFT_CENTER up
2600 capture screen undo_layer_closed

# Hold LEFT_CENTER again and redo from the transient history layer.
2700 button LEFT_CENTER down
3700 tick
3750 capture screen redo_layer
3800 tap LEFT_BOTTOM 60
3950 capture screen length_redone
4050 button LEFT_CENTER up
4250 capture screen redo_layer_closed
