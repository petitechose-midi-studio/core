# UX workflow: restore an automated Macro from Manual to Auto through the
# contextual Automation shortcut in Macro Edit.
# Purpose: validates the common grammar: LEFT_BOTTOM + Macro opens Edit,
# NAV focuses Automation, LEFT_BOTTOM + NAV chooses Playback, OPT resumes Auto.
# Expect: capture_changed:automation_recorded=manual_override_active, capture_changed:manual_override_active=macro_editor_open, capture_changed:automation_playback_shortcut=automation_restored_auto
# Expect: semantic:automation_restored_auto:effect=edit_macro_context_property

0 scenario macro-automation-clean
50 capture screen macro_ready

# Record automation on Macro 1.
150 button LEFT_CENTER down
500 encoder MACRO_1 1.00
1100 button LEFT_CENTER up
1250 capture screen automation_recorded

# User takes manual control over the automated macro.
1400 encoder MACRO_1 0.20
1550 capture screen manual_override_active

# Open Macro Edit with the explicit chord, then focus Automation.
1700 button LEFT_BOTTOM down
1800 capture screen macro_edit_prompt
1900 tap MACRO_1 60
2020 capture screen macro_editor_open
2120 button LEFT_BOTTOM up
2260 encoder NAV 1
2400 capture screen automation_property_selected

# Hold LEFT_BOTTOM to expose Automation properties. Playback is the default;
# setting it On also releases the Manual override without deleting the lane.
2520 button LEFT_BOTTOM down
2660 capture screen automation_playback_shortcut
2800 encoder OPT 1.00
2940 capture screen automation_restored_auto
3040 button LEFT_BOTTOM up

# Back closes Macro Edit only.
3180 tap LEFT_TOP 60
3340 capture screen macro_editor_closed
