# UX workflow: adjust a macro, open its edit overlay, edit one field, and close.
# Purpose: validates macro performance input, explicit Edit-chord opening,
# the shared opaque value selector, overlay-local NAV/OPT routing, and commit.
# Expect: capture_changed:edit_open=destination_selector_open, capture_changed:destination_selector_open=destination_selector_moved, capture_changed:destination_selector_moved=destination_applied, capture_changed:edit_open=edit_adjusted

0 scenario macro
50 capture screen macro_ready

# User turns a macro encoder in performance mode.
150 encoder MACRO_1 0.75
250 capture screen macro_value_changed

# Hold LEFT_BOTTOM: the prompt explains that pressing a Macro opens Edit.
350 button LEFT_BOTTOM down
430 capture screen edit_prompt
520 tap MACRO_1 60
1400 tick
1450 capture screen edit_open
1500 button LEFT_BOTTOM up

# Open the Destination value selector, move once, and apply. The selector must
# replace the editor chrome instead of letting its text leak through.
1600 tap NAV 60
1820 capture screen destination_selector_open
1920 encoder NAV 1
2140 capture screen destination_selector_moved
2240 tap NAV 60
2460 capture screen destination_applied

# Move focus and edit the next property with OPT.
2560 encoder NAV 1
2660 encoder OPT 0.50
2880 capture screen edit_adjusted

# Close and commit.
2980 tap LEFT_TOP 60
3200 capture screen edit_closed
