# UX workflow: coarse edit macro automation length and offset.
# Purpose: validates that LEFT_CENTER acts as a temporary coarse modifier for
# Length and Offset while the normal automation editor remains visible.
# Expect: capture_changed:macro_1_automation_detail=macro_1_automation_length_coarse, capture_changed:macro_1_automation_length_coarse=macro_1_automation_offset_coarse

0 scenario macro-automation-curve-shape
80 capture screen macro_grid_curve_source

# Open Macro Edit for Macro 1.
180 button LEFT_BOTTOM down
260 tap MACRO_1 60
1280 tick
1360 capture screen macro_1_edit_detail
1460 button LEFT_BOTTOM up

# Open Automation detail and focus Length.
1620 encoder NAV 1
1780 tap NAV 60
2020 capture screen macro_1_automation_detail
# Convert is the primary action directly below Playback; Length follows it.
2100 encoder NAV 1
2180 encoder NAV 1

# Hold LEFT_CENTER for coarse editing and jump Length by 4-beat units.
2340 button LEFT_CENTER down
2500 encoder OPT 0.20
2740 capture screen macro_1_automation_length_coarse
2860 button LEFT_CENTER up

# Focus Offset and use the same coarse modifier.
3020 encoder NAV 1
3180 button LEFT_CENTER down
3340 encoder OPT 2.00
3580 capture screen macro_1_automation_offset_coarse
3700 button LEFT_CENTER up
