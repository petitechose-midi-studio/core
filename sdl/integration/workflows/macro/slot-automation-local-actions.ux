# UX workflow: manage a focused typed Macro Slot from the macro grid.
# Purpose: validates tap Copy, early-release Remove cancellation, hold Paste,
# and guarded whole-Slot Remove without entering Macro Edit.
# Expect: capture_match:macro_2_slot_copied=macro_2_remove_cancelled, capture_match:macro_2_slot_copied=macro_2_slot_pasted
# Expect: capture_match:macro_2_slot_pasted=macro_2_paste_settled, capture_changed:macro_2_slot_copied=macro_2_slot_removed
# Expect: capture_match:macro_2_slot_removed=macro_2_remove_settled
# Expect: semantic:macro_2_remove_cancelled:effect=cancel_remove_macro_slot, semantic:macro_2_remove_cancelled:outcome=cancelled
# Expect: semantic:macro_2_slot_pasted:effect=paste_macro_slot, semantic:macro_2_slot_pasted:outcome=applied
# Expect: semantic:macro_2_slot_removed:effect=remove_macro_slot, semantic:macro_2_slot_removed:outcome=applied

0 scenario macro-track-multipage-automation
80 capture screen source_macro_grid

# Enter Macro slot focus and focus Macro 2, which owns an automation lane.
180 tap NAV 60
320 tap NAV 60
460 encoder NAV 1
620 capture screen macro_2_focused

# Tap copies the complete focused Slot.
760 tap BOTTOM_RIGHT 60
920 capture screen macro_2_slot_copied

# A short Remove press is explicitly cancelled and leaves the Slot unchanged.
1060 tap BOTTOM_LEFT 60
1220 capture screen macro_2_remove_cancelled

# Holding Paste applies the typed Slot once; release is consumed.
1360 button BOTTOM_RIGHT down
2500 tick
2550 capture screen macro_2_slot_pasted
2600 button BOTTOM_RIGHT up
2850 capture screen macro_2_paste_settled

# Guarded Remove deletes the whole Slot once; release cannot replay it.
3000 button BOTTOM_LEFT down
4140 tick
4190 capture screen macro_2_slot_removed
4240 button BOTTOM_LEFT up
4490 capture screen macro_2_remove_settled
