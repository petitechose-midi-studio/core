# UX workflow: copy/paste a macro track with several pages and automations.
# Purpose: confirms that the visible workflow preserves the full track payload,
# not only the active page.
# Expect: capture_changed:track_add_target=pasted_track_page_3

0 scenario macro-track-multipage-automation
80 capture screen source_track_page_3

# Enter Structure / Tracks, then copy Track 1.
120 button NAV down
1190 tick
1250 button NAV up
1400 tap BOTTOM_RIGHT 60
1550 capture screen track_copied

# Move to the next track add slot and paste the full track there.
1700 encoder NAV 1
1860 capture screen track_add_target
2000 button BOTTOM_RIGHT down
3140 tick
3240 button BOTTOM_RIGHT up
3490 capture screen pasted_track_page_3

# Apply Track -> Page, leave Structure, then focus Macro 2. The pasted track
# must still expose Page 3 and keep both Automation lanes.
3640 tap NAV 60
3790 tap NAV 60
3940 tap NAV 60
4090 encoder NAV 1
4240 capture screen pasted_track_macro_2_focused
