# UX workflow: copy/paste a macro track with several pages and automations.
# Purpose: confirms that the visible workflow preserves the full track payload,
# not only the active page.
# Expect: capture_changed:track_add_target=pasted_track_page_3

0 scenario macro-track-multipage-automation
80 capture screen source_track_page_3

# Switch the held-NAV context Page -> Track, then copy the focused Track 1.
# This workflow validates the complete Track payload; multi-selection is
# covered separately.
120 button NAV down
200 encoder NAV -1
280 button NAV up
420 tap BOTTOM_RIGHT 60
570 capture screen track_copied

# Move to the next track add slot and paste the full track there.
720 encoder NAV 1
880 capture screen track_add_target
1020 button BOTTOM_RIGHT down
2160 tick
2260 button BOTTOM_RIGHT up
2510 capture screen pasted_track_page_3

# Use the same held selector Track -> Page -> Macro and focus Macro 2. The
# pasted track must still expose Page 3 and keep both Automation lanes.
2650 button NAV down
2730 encoder NAV 1
2810 encoder NAV 1
2890 button NAV up
3030 encoder NAV 1
3190 capture screen pasted_track_macro_2_focused
