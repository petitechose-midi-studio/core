# UX workflow: record a reusable relative Source from one Macro destination.
# Purpose: proves the destination-first typed action, lazy signed capture,
# live preview, one atomic Source+binding commit, and the exact Source deep-link.
# Expect: capture_changed:macro_ready=record_context, capture_changed:record_context=shape_recording, capture_changed:shape_recording=shape_committed
# Expect: capture_changed:shape_committed=assignment_detail, capture_changed:assignment_detail=source_workspace
# Expect: semantic:record_context:effect=show_macro_context_properties
# Expect: semantic:shape_recording:effect=record_macro_recorded_shape_value, semantic:shape_recording:operation_status=recording
# Expect: semantic:shape_committed:effect=commit_macro_recorded_shape, semantic:shape_committed:operation_status=committed, semantic:shape_committed:outcome=applied
# Expect: semantic:assignment_detail:mode=macro.modulation_editor, semantic:source_workspace:mode=project.modulator_detail, semantic:source_workspace:source=recorded_shape

0 scenario macro-automation-clean
80 capture screen macro_ready

# Reuse the learned Macro Edit chord and focus the Modulation domain.
180 button LEFT_BOTTOM down
260 tap MACRO_1 60
380 button LEFT_BOTTOM up
520 encoder NAV 1
600 encoder NAV 1

# The first contextual item is Record New Shape. The hold only exposes intent;
# RAW OPT movement lazily creates and auditions the signed Project Source.
720 button LEFT_BOTTOM down
940 capture screen record_context
1060 encoder OPT 64.00
1320 tick
1540 capture screen shape_recording

# Modifier release is the only publish boundary: Source plus destination edge
# become one history action and the new assignment receives focus.
1660 button LEFT_BOTTOM up
1940 capture screen shape_committed

# NAV opens the focused assignment, then NAV again reaches the same complete
# Project Source editor used by Project Modulators.
2060 tap NAV 60
2300 capture screen assignment_detail
2420 tap NAV 60
2700 capture screen source_workspace
