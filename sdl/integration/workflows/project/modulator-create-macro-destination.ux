# UX workflow: atomic Project Modulator destination and Macro creation.
# Purpose: proves an audible full-Source preview, explicit Depth, exact Cancel,
# learned Apply/Back grammar, and one Undo/Redo for Macro + source + edge.
# Expect: capture_changed:empty_registry=source_kind_picker, capture_changed:source_kind_picker=destination_picker, capture_changed:destination_picker=add_macro_focused, capture_changed:add_macro_focused=macro_destination_preview
# Expect: capture_changed:macro_destination_preview=preview_depth_edited, capture_changed:preview_depth_edited=preview_cancelled, capture_changed:preview_cancelled=destination_applied
# Expect: capture_changed:destination_applied=creation_undone, capture_changed:creation_undone=creation_redone
# Expect: semantic:macro_destination_preview:mode=project.modulator_detail, semantic:macro_destination_preview:projection=audible_audition
# Expect: semantic:preview_depth_edited:effect=edit_modulator_depth, semantic:preview_depth_edited:property=depth, semantic:preview_cancelled:effect=cancel_destination_audition
# Expect: semantic:destination_applied:effect=apply_destination_audition, semantic:destination_applied:outcome=applied

0 scenario project-modulator-destination
80 capture screen project_overview

180 button LEFT_CENTER down
780 encoder NAV 1
860 encoder NAV 2
940 encoder NAV 3
1020 encoder NAV 4
1100 encoder NAV 5
1180 button LEFT_CENTER up
1400 capture screen empty_registry

# Add Source asks for its type, then opens the destination picker.
1520 tap NAV 60
1740 capture screen source_kind_picker
1860 tap NAV 60
2080 capture screen destination_picker
2200 encoder NAV 1
2420 capture screen add_macro_focused

# Creating M2 opens the full provisional Source workspace. Depth is the last
# LFO card, visibly tied to the implied destination.
2540 tap NAV 60
2780 capture screen macro_destination_preview
2900 encoder NAV 1
2960 encoder NAV 1
3020 encoder NAV 1
3080 encoder NAV 1
3140 encoder NAV 1
3260 encoder OPT 0.80
3480 capture screen preview_depth_edited
3600 tap LEFT_TOP 60
3840 capture screen preview_cancelled

# Repeat and Apply with the same bottom-right grammar.
3960 tap NAV 60
4200 tap BOTTOM_RIGHT 60
4440 capture screen destination_applied

# The whole creation is one action; Undo/Redo leaves no partial structure.
4560 button LEFT_CENTER down
5160 tap LEFT_TOP 60
5380 button LEFT_CENTER up
5620 capture screen creation_undone
5740 button LEFT_CENTER down
6340 tap LEFT_BOTTOM 60
6560 button LEFT_CENTER up
6800 capture screen creation_redone
