# UX workflow: source-first visual Modulator workspace and complete LFO range.
# Purpose: proves retained curves, exact temporary feedback, 1/64..32 Bars,
# 8 ms..32 s Free timing, local Details/Back, rename, disabled treatment, and
# an always-visible Destinations action at 320x240.
# Expect: capture_changed:registry=lfo_workspace, capture_changed:lfo_workspace=shape_feedback, capture_changed:shape_feedback=sync_fast_feedback, capture_changed:sync_fast_feedback=sync_slow_feedback
# Expect: capture_changed:sync_slow_feedback=free_fast_feedback, capture_changed:free_fast_feedback=free_slow_feedback, capture_changed:free_slow_feedback=details_workspace
# Expect: capture_changed:details_workspace=phase_feedback, capture_changed:phase_feedback=phase_stable, capture_changed:rename_keyboard=renamed_details
# Expect: capture_changed:recorded_workspace=recorded_disabled, capture_changed:recorded_disabled=recorded_destinations_focused
# Expect: semantic:lfo_workspace:effect=open_modulator_detail, semantic:shape_feedback:effect=edit_modulator_property
# Expect: semantic:sync_fast_feedback:property=rate, semantic:sync_slow_feedback:property=rate, semantic:free_fast_feedback:property=rate, semantic:free_slow_feedback:property=rate
# Expect: semantic:details_workspace:mode=project.modulator_options

0 scenario project-modulator-workspace

100 button LEFT_TOP down
700 encoder NAV -1
1100 button LEFT_TOP up
1320 capture screen registry

# Source level: Shape / Timing / Rate / Details / Destinations.
1440 tap NAV 60
1660 capture screen lfo_workspace
1780 encoder OPT 0.75
2000 capture screen shape_feedback

# The complete supported Sync range is explicit on the Rate card.
2120 encoder NAV 1
2180 encoder NAV 1
2300 encoder OPT 0.00
2520 capture screen sync_fast_feedback
2640 encoder OPT 1.00
2860 capture screen sync_slow_feedback

# Free keeps the same card and spans fast control to slow evolving movement.
2980 encoder NAV -1
3100 encoder OPT 1.00
3220 encoder NAV 1
3340 encoder OPT 0.00
3560 capture screen free_fast_feedback
3680 encoder OPT 1.00
3900 capture screen free_slow_feedback

# Details is local and keeps the source curve visible.
4020 encoder NAV 1
4140 tap NAV 60
4360 capture screen details_workspace
4480 encoder OPT 0.90
4700 capture screen phase_feedback
5700 tick
5860 capture screen phase_stable

# Rename is the third Details card and returns to the same local context.
5980 encoder NAV 1
6040 encoder NAV 1
6160 tap NAV 60
6380 capture screen rename_keyboard
6500 tap LEFT_BOTTOM 60
6620 tap NAV 60
6740 tap BOTTOM_RIGHT 60
6960 capture screen renamed_details

# Back remains local first, then restores registry focus. Open Recorded Shape.
7080 tap LEFT_TOP 60
7200 tap LEFT_TOP 60
7320 encoder NAV 1
7380 encoder NAV 1
7500 tap NAV 60
7720 capture screen recorded_workspace

# Disabled remains explicit; Destinations stays visible and directly reachable.
7840 tap BOTTOM_LEFT 60
8060 capture screen recorded_disabled
8180 encoder NAV 1
8240 encoder NAV 1
8300 encoder NAV 1
8520 capture screen recorded_destinations_focused
8640 tap NAV 60
8860 capture screen recorded_destinations
