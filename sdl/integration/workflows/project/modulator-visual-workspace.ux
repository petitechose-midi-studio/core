# UX workflow: source-first visual Modulator workspace.
# Purpose: proves the stable LFO and Recorded Shape grammar, retained curve,
# temporary exact feedback, phase-shifted curve, local Details/Back, rename,
# disabled treatment,
# and an always-visible Destinations action at 320x240.
# Expect: capture_changed:registry=lfo_workspace, capture_changed:lfo_workspace=shape_feedback, capture_changed:shape_feedback=shape_stable, capture_changed:shape_stable=free_timing_feedback
# Expect: capture_changed:free_timing_feedback=details_workspace, capture_changed:details_workspace=phase_feedback, capture_changed:phase_feedback=phase_stable
# Expect: capture_changed:rename_keyboard=renamed_details, capture_changed:recorded_workspace=recorded_disabled, capture_changed:recorded_disabled=recorded_destinations_focused
# Expect: semantic:lfo_workspace:effect=open_modulator_detail, semantic:shape_feedback:effect=edit_modulator_property, semantic:details_workspace:mode=project.modulator_options

0 scenario project-modulator-workspace

# Learned Project shortcut opens the compact Project-owned registry.
100 button LEFT_CENTER down
700 encoder NAV 1
780 encoder NAV 2
860 encoder NAV 3
940 encoder NAV 4
1020 encoder NAV 5
1100 button LEFT_CENTER up
1320 capture screen registry

# Source level: Shape / Timing / Rate / Details / Destinations.
1440 tap NAV 60
1660 capture screen lfo_workspace
1780 encoder OPT 0.75
1980 capture screen shape_feedback
2940 tick
3100 capture screen shape_stable

# Timing immediately switches the Rate card from musical division to time.
3220 encoder NAV 1
3340 encoder OPT 1.0
3540 capture screen free_timing_feedback

# Details is local and keeps the same curve plus visible Destinations.
3660 encoder NAV 1
3740 encoder NAV 1
3860 tap NAV 60
4080 capture screen details_workspace

# Phase edits move the authored curve itself; temporary precision feedback
# disappears without reverting the phase-shifted source preview.
4200 encoder OPT 0.90
4420 capture screen phase_feedback
5420 tick
5580 capture screen phase_stable

# Rename reuses the controller keyboard and returns locally to Details.
5700 encoder NAV 1
5780 encoder NAV 1
5860 encoder NAV 1
5980 tap NAV 60
6200 capture screen rename_keyboard
6320 tap LEFT_BOTTOM 60
6440 tap NAV 60
6560 tap BOTTOM_RIGHT 60
6780 capture screen renamed_details

# Back remains local first, then restores registry focus. Open Recorded Shape.
6900 tap LEFT_TOP 60
7020 tap LEFT_TOP 60
7140 encoder NAV 1
7220 encoder NAV 1
7340 tap NAV 60
7560 capture screen recorded_workspace

# Disabled remains explicit in header/icon/text; Destinations never clips.
7680 tap BOTTOM_LEFT 60
7900 capture screen recorded_disabled
8020 encoder NAV 1
8100 encoder NAV 1
8180 encoder NAV 1
8400 capture screen recorded_destinations_focused
8520 tap NAV 60
8740 capture screen recorded_destinations
