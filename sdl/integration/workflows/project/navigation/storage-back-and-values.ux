# UX workflow: inspect Project Storage actions and back out without mutation.
# Purpose: validates the current lifecycle authority, focus on the disabled
# project identity row, and LEFT_TOP at a tab root. No save/load action is fired.
# Expect: capture_changed:storage_save_focused=storage_identity_focused, capture_changed:storage_identity_focused=selector_from_storage_root
# Expect: semantic:storage_save_focused:property=storage, semantic:storage_save_focused:value_label=storage_root, semantic:storage_save_focused:target_index=0
# Expect: semantic:storage_identity_focused:target_index=5, semantic:selector_from_storage_root:overlay=view_selector

0 capture screen boot

# Enter Project from the global selector.
100 button LEFT_TOP down
220 capture screen selector_open
300 encoder NAV 1
380 encoder NAV 1
460 encoder NAV 1
520 capture screen project_item_selected
580 button LEFT_TOP up
720 capture screen project_overview

# Move to Storage using the first-level tab shortcut.
820 button LEFT_CENTER down
1420 encoder NAV 0.01
1500 encoder NAV 0.01
1580 encoder NAV 0.01
1660 encoder NAV 0.01
1760 capture screen storage_tab
1840 button LEFT_CENTER up
2040 capture screen storage_save_focused

# Move through the five lifecycle actions to the read-only project identity.
2140 encoder NAV 0.01
2220 encoder NAV 0.01
2300 encoder NAV 0.01
2380 encoder NAV 0.01
2460 encoder NAV 0.01
2620 capture screen storage_identity_focused

# From a tab root, LEFT_TOP opens the global selector.
2720 button LEFT_TOP down
2900 capture screen selector_from_storage_root
2980 button LEFT_TOP up
