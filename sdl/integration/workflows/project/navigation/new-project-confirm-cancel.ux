# UX workflow: cancel the New Project confirmation without resetting musical state.
# Purpose: validates that the confirmation screen is navigable and that Cancel
# returns to the previous Project context.
# Expect: capture_changed:project_overview=new_project_confirm_default, capture_match:project_overview=project_overview_after_cancel

0 capture screen boot

# Enter Project from the global selector.
100 button LEFT_TOP down
220 capture screen selector_open
300 encoder NAV 1
380 encoder NAV 1
460 encoder NAV 1
520 capture screen project_item_selected
580 button LEFT_TOP up
720 capture screen project_overview

# Open New Project confirmation, move to Cancel, and apply it.
820 tap NAV 60
1080 capture screen new_project_confirm_default
1180 encoder NAV 1
1320 capture screen new_project_confirm_cancel_focused
1400 tap NAV 60
1680 capture screen project_overview_after_cancel
