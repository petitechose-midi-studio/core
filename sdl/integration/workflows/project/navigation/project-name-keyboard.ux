# UX workflow: inspect the Project name keyboard.
# Purpose: captures the compact QWERTY keyboard used by Save As/Rename, including
# text insertion and physical soft-key action strips.
# Expect: capture_changed:keyboard_initial=keyboard_uppercase_q_inserted, capture_changed:keyboard_q_before_cancel=keyboard_reopened

0 capture screen boot

# Enter Project from the global selector.
100 button LEFT_TOP down
220 capture screen selector_open
300 encoder NAV 1
380 encoder NAV 1
460 encoder NAV 1
520 capture screen project_item_selected
580 button LEFT_TOP up
720 capture screen project_overview

# Open Overview > Save As.
820 encoder NAV 1
900 encoder NAV 1
980 encoder NAV 1
1120 capture screen save_as_focused
1220 tap NAV 60
1460 capture screen keyboard_initial

# Hold LEFT_CENTER as Shift, insert an uppercase default key, then insert Space.
1560 button LEFT_CENTER down
1700 capture screen keyboard_shift_active
1800 tap NAV 60
2020 capture screen keyboard_uppercase_q_inserted
2120 button LEFT_CENTER up
2260 tap BOTTOM_CENTER 60
2480 capture screen keyboard_space_inserted

# Move horizontally across the letter row.
2580 encoder NAV 1
2660 encoder NAV 1
2740 encoder NAV 1
2820 encoder NAV 1
3040 capture screen keyboard_letter_focus

# The action keys are physical: bottom-left backspaces, left-bottom clears,
# left-top cancels, bottom-right validates.
3140 tap BOTTOM_LEFT 60
3380 capture screen keyboard_backspace_action
3480 tap NAV 60
3720 capture screen keyboard_q_reinserted
3820 tap LEFT_BOTTOM 60
4060 capture screen keyboard_clear_action
4160 tap NAV 60
4400 capture screen keyboard_q_before_cancel
4500 tap LEFT_TOP 60
4860 capture screen keyboard_cancelled

# Re-open Save As and validate through the bottom-right action.
4960 tap NAV 60
5200 capture screen keyboard_reopened
5300 tap NAV 60
5540 capture screen keyboard_q_before_validate
5640 tap BOTTOM_RIGHT 60
6080 capture screen keyboard_validated
