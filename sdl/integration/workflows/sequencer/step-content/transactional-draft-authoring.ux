# UX workflow: transactional Step-content authoring from draft to history.
# Purpose: proves that a new Micro-sequence stays private while edited, Back
# exposes the safe Save decision, publication happens once, the reopened child
# is ordinary published content, and one global Undo/Redo removes/restores the
# whole authored child.
# Expect: semantic:micro_draft_open:mode=sequencer.step_content_draft, semantic:micro_draft_open:draft_kind=micro_sequence, semantic:micro_draft_open:draft_active=1, semantic:micro_draft_open:dirty=0, semantic:micro_draft_open:action=apply
# Expect: semantic:micro_draft_dirty:draft_kind=micro_sequence, semantic:micro_draft_dirty:draft_active=1, semantic:micro_draft_dirty:dirty=1, semantic:micro_draft_dirty:action=apply
# Expect: semantic:save_draft_prompt:mode=sequencer.step_content_draft.exit, semantic:save_draft_prompt:exit_choice=save, semantic:save_draft_prompt:dirty=1, semantic:save_draft_prompt:action=save
# Expect: semantic:micro_published:effect=resolve_draft_exit, semantic:micro_published:draft_kind=micro_sequence, semantic:micro_published:draft_active=0, semantic:micro_published:published=1, semantic:micro_published:action=save
# Expect: semantic:published_micro_copied:effect=copy_step_editor_context, semantic:published_micro_copied:action=copy
# Expect: semantic:undo_publish_ready:mode=view_selector, semantic:undo_publish_applied:effect=undo_project_action, semantic:undo_publish_applied:intent=undo
# Expect: semantic:redo_publish_ready:mode=view_selector, semantic:redo_publish_applied:effect=redo_project_action, semantic:redo_publish_applied:intent=redo
# Expect: semantic:micro_publish_undone:mode=sequencer.step_edit, semantic:micro_publish_undone:published=0, semantic:micro_publish_redone:mode=sequencer.step_edit, semantic:micro_publish_redone:published=1
# Expect: capture_changed:micro_draft_open=micro_draft_dirty, capture_changed:micro_published=published_micro_reopened, capture_changed:micro_publish_undone=micro_publish_redone

0 scenario sequencer

# Pattern -> Step uses the shared held-NAV context selector. A short NAV tap
# then opens the editor for the focused root Step.
100 button NAV down
180 encoder NAV 0.01
240 button NAV up
500 tap MACRO_1 60
720 tap NAV 60
980 capture screen root_step_editor

# Focus Micro-sequence and create it. The child is visible and editable, but
# the published Pattern still has no Micro child at this point.
1080 encoder NAV 0.01
1160 encoder NAV 0.01
1240 encoder NAV 0.01
1320 encoder NAV 0.01
1400 encoder NAV 0.01
1480 encoder NAV 0.01
1560 encoder NAV 0.01
1660 tap NAV 60
1980 capture screen micro_draft_open

# Make the draft dirty with one direct musical gesture.
2080 tap MACRO_1 60
2320 capture screen micro_draft_dirty

# Back never silently commits: the explicit decision surface defaults to Save.
2420 tap LEFT_TOP 60
2700 capture screen save_draft_prompt
2800 tap NAV 60
3160 capture screen micro_published

# Reopen the published row. Its bottom-right action is Copy again; Apply only
# belonged to the unpublished draft.
3260 tap NAV 60
3460 encoder NAV 0.01
3540 encoder NAV 0.01
3620 encoder NAV 0.01
3700 encoder NAV 0.01
3780 encoder NAV 0.01
3860 encoder NAV 0.01
3940 encoder NAV 0.01
4120 capture screen published_micro_row
4220 tap BOTTOM_RIGHT 60
4460 capture screen published_micro_copied
4560 tap NAV 60
4860 capture screen published_micro_reopened
4960 tap LEFT_TOP 60
5280 capture screen root_after_reopen

# Publication owns exactly one history entry. Undo removes the complete child;
# Redo restores the exact published state.
5380 tap LEFT_TOP 60
5580 tap LEFT_TOP 60
5780 tap LEFT_TOP 60
6460 tick
6520 capture screen undo_publish_ready
6620 tap LEFT_CENTER 60
6840 capture screen undo_publish_applied
8120 tick
8180 tap LEFT_TOP 60

# Re-enter the Pattern, restore the Step context explicitly, and inspect the
# same Micro row: one Undo removed the whole published child.
8280 tap LEFT_CENTER 60
8350 tap LEFT_TOP 60
8420 button NAV down
8500 encoder NAV 0.01
8560 button NAV up
8660 tap NAV 60
8780 encoder NAV 0.01
8860 encoder NAV 0.01
8940 encoder NAV 0.01
9020 encoder NAV 0.01
9100 encoder NAV 0.01
9180 encoder NAV 0.01
9260 encoder NAV 0.01
9500 capture screen micro_publish_undone
9600 tap LEFT_TOP 60

# Close Step Edit, cancel the Step context, and return through the launcher to
# the same global history surface.
9800 tap LEFT_TOP 60
10000 tap LEFT_TOP 60
10200 tap LEFT_TOP 60
10780 tick
10840 capture screen redo_publish_ready
10940 tap LEFT_BOTTOM 60
11160 capture screen redo_publish_applied
12440 tick
12500 tap LEFT_TOP 60

# Redo restores that same published child; rebuild the Step context and inspect
# the ordinary published Edit row again.
12600 tap LEFT_CENTER 60
12670 tap LEFT_TOP 60
12750 button NAV down
12830 encoder NAV 0.01
12890 button NAV up
13000 tap NAV 60
13100 encoder NAV 0.01
13180 encoder NAV 0.01
13260 encoder NAV 0.01
13340 encoder NAV 0.01
13420 encoder NAV 0.01
13500 encoder NAV 0.01
13580 encoder NAV 0.01
13820 capture screen micro_publish_redone
