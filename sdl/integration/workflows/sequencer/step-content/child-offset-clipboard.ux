# UX workflow: child step wrap offset and typed step-content clipboard.
# Purpose: validates that micro/cycle child contexts expose root-like step wrap
# offset through quick controls and that row-level clipboard actions only paste
# matching child kinds.
# Expect: capture_changed:micro_step_edit_open=micro_step_pitch_offset, capture_changed:child_quick_offset=child_offset_shifted, capture_changed:micro_row_paste_ready=micro_row_pasted

0 scenario sequencer
50 capture screen sequencer_ready

# Enable root step 1 and create a micro-sequence child context.
150 tap MACRO_1 60
320 capture screen root_step_enabled
420 button MACRO_1 down
1480 tick
1540 capture screen root_step_edit_open
1600 button MACRO_1 up
1700 encoder NAV 1
1780 encoder NAV 1
1860 encoder NAV 1
1940 encoder NAV 1
2020 encoder NAV 1
2100 encoder NAV 1
2180 encoder NAV 1
2260 capture screen micro_row_focused
2360 tap NAV 60
2660 capture screen micro_context_open

# Give the first micro step an audible pitch offset so wrap movement is visible.
2760 button MACRO_1 down
3820 tick
3880 capture screen micro_step_edit_open
3940 button MACRO_1 up
4040 encoder NAV 1
4100 encoder NAV 1
4180 encoder OPT 0.72
4360 capture screen micro_step_pitch_offset
4460 tap NAV 60
4700 capture screen micro_pitch_offset_applied

# Return from Step focus to the child Pattern focus. Quick controls in a child
# context must then expose Length and Offset, with no Division.
4740 tap NAV 20
4780 tap NAV 20
4840 capture screen child_pattern_focus
4900 button LEFT_CENTER down
5160 capture screen child_quick_length
5260 encoder NAV 1
5460 capture screen child_quick_offset
5560 encoder OPT 4.00
5780 capture screen child_offset_shifted
5880 button LEFT_CENTER up
6100 capture screen micro_offset_applied

# Copy only the micro-sequence row from step 1.
6160 tap LEFT_TOP 60
6500 capture screen returned_root_with_micro_badge
6600 button MACRO_1 down
7660 tick
7720 capture screen root_step_edit_for_copy
7780 button MACRO_1 up
7880 encoder NAV 1
7960 encoder NAV 1
8040 encoder NAV 1
8120 encoder NAV 1
8200 encoder NAV 1
8280 encoder NAV 1
8360 encoder NAV 1
8440 capture screen micro_row_copy_ready
8540 tap BOTTOM_RIGHT 60
8800 capture screen micro_row_copied
8900 tap LEFT_TOP 60

# A micro clipboard must not paste into the cycle-state row.
9200 button MACRO_2 down
10260 tick
10320 capture screen step_2_edit_open
10380 button MACRO_2 up
10480 encoder NAV 1
10560 encoder NAV 1
10640 encoder NAV 1
10720 encoder NAV 1
10800 encoder NAV 1
10880 encoder NAV 1
10960 encoder NAV 1
11040 encoder NAV 1
11120 capture screen cycle_row_paste_blocked
11220 button BOTTOM_RIGHT down
12440 tick
12500 button BOTTOM_RIGHT up
12800 capture screen cycle_row_after_wrong_paste

# The same clipboard should paste into the micro-sequence row.
12900 encoder NAV -1
13100 capture screen micro_row_paste_ready
13200 button BOTTOM_RIGHT down
14420 tick
14480 button BOTTOM_RIGHT up
14820 capture screen micro_row_pasted
