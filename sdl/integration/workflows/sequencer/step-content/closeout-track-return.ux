# UX workflow: ADR-0015/0016 closeout track-return persistence smoke.
# Purpose: validates that child content remains visible after leaving the child
# context, changing track, and returning to the original track. This guards the
# regression where nested contexts disappeared after track navigation.
# Expect: capture_changed:t02_created=t01_returned_after_track_switch, capture_changed:t01_step_edit_after_return=t01_micro_context_reopened_after_return

0 scenario sequencer
50 capture screen sequencer_ready

# Enable Track 1 step 1, open its step editor, and create a micro-sequence.
150 tap MACRO_1 60
320 capture screen t01_step_enabled
420 button MACRO_1 down
1480 tick
1540 capture screen t01_step_edit_open
1600 button MACRO_1 up
1700 encoder NAV 0.01
1780 encoder NAV 0.01
1860 encoder NAV 0.01
1940 encoder NAV 0.01
2020 encoder NAV 0.01
2100 encoder NAV 0.01
2180 encoder NAV 0.01
2260 capture screen t01_micro_row_focused
2360 tap NAV 60
2660 capture screen t01_micro_context_open

# Edit micro step 1 so the child content is visibly non-empty.
2760 button MACRO_1 down
3820 tick
3880 capture screen t01_micro_step_edit_open
3940 button MACRO_1 up
4040 encoder NAV 0.01
4140 encoder OPT 0.72
4360 capture screen t01_micro_step_note_offset
4460 tap NAV 60
4700 capture screen t01_micro_context_edited
4720 tap BOTTOM_RIGHT 40

# Return to the root grid.
4800 tap LEFT_TOP 60
5140 capture screen t01_parent_after_micro
5240 tap LEFT_TOP 60
5580 capture screen t01_root_badge_before_track_switch

# Track switching now goes through the Clip Launcher hierarchy. Return to the
# matrix, move from the T1 header to the T2 add header, create an Instrument
# Track, then move back from T2/C1 to T1/C1 and reopen it.
5680 tap LEFT_TOP 60
5900 encoder NAV -0.01
5980 button LEFT_CENTER down
6060 encoder NAV 0.01
6140 button LEFT_CENTER up
6180 capture screen t02_add_preview
6280 tap NAV 60
6580 capture screen t02_type_instrument
6680 tap NAV 60
7080 capture screen t02_created
7180 tap LEFT_TOP 60
7380 button LEFT_CENTER down
7460 encoder NAV -0.01
7540 button LEFT_CENTER up
7640 tap LEFT_CENTER 60
7800 tap LEFT_TOP 60
7980 capture screen t01_returned_after_track_switch

# Re-open Track 1 step 1. The micro-sequence row must still be present and
# openable; the user should not have to recreate child content.
8180 button MACRO_1 down
9240 tick
9300 capture screen t01_step_edit_after_return
9360 button MACRO_1 up
9460 encoder NAV 0.01
9540 encoder NAV 0.01
9620 encoder NAV 0.01
9700 encoder NAV 0.01
9780 encoder NAV 0.01
9860 encoder NAV 0.01
9940 encoder NAV 0.01
10020 capture screen t01_micro_row_still_present
10120 tap NAV 60
10420 capture screen t01_micro_context_reopened_after_return
