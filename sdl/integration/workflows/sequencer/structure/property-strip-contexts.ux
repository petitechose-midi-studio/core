# UX workflow: verify the direct Pattern/Step control grammar.
# Purpose: keeps Pattern quick controls intact, proves Step LEFT_CENTER owns
# State/Chance/Note/Velocity/Gate/Nudge, and Step LEFT_BOTTOM exposes semantic
# Variation/Chord/Micro/Cycle/Select actions without duplicating Step Editor.
# Expect: capture_changed:step_state_on=step_state_off, capture_changed:step_content_chord_selected=step_editor_chord_open, capture_changed:root_pattern_initial=pattern_after_step_edit

0 scenario sequencer
50 capture screen root_pattern_initial

# Pattern keeps its direct quick controls on LEFT_CENTER and musical property
# selector on LEFT_BOTTOM.
150 button LEFT_CENTER down
350 capture screen pattern_quick_selector_open
400 button LEFT_CENTER up
600 capture screen pattern_quick_selector_closed
700 button LEFT_BOTTOM down
900 capture screen pattern_property_selector_open
950 button LEFT_BOTTOM up
1150 capture screen pattern_property_selector_closed

# Step LEFT_CENTER starts on Note. Move to State, switch the focused step Off,
# and apply on release. The overlay must report the authored value immediately.
1250 tap NAV 60
1450 tap MACRO_1 60
1650 capture screen step_state_on
1750 button LEFT_CENTER down
1950 capture screen step_property_note_selected
2050 encoder NAV -1
2130 encoder NAV -1
2250 capture screen step_property_state_selected
2350 encoder OPT -2.0
2550 capture screen step_state_off_in_selector
2600 button LEFT_CENTER up
2850 capture screen step_state_off

# LEFT_BOTTOM is the semantic content selector. Chord delegates to the existing
# Step Editor at its Chord row; closing it returns to the original Pattern view.
2950 button LEFT_BOTTOM down
3150 capture screen step_content_variation_selected
3250 encoder NAV 1
3450 capture screen step_content_chord_selected
3500 button LEFT_BOTTOM up
3800 capture screen step_editor_chord_open
3900 tap LEFT_TOP 60
4200 capture screen step_after_chord_editor
4300 tap NAV 60
4550 capture screen pattern_after_step_edit
