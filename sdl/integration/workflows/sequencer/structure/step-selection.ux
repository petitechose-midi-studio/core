# UX workflow: enter Step selection from a stationary NAV hold.
# Purpose: validates contextual selection entry, immediate feedback, sparse copy
# footprint, paste preview, and one complete paste action.
# Expect: capture_changed:step_selection_entered=steps_3_5_selected, capture_changed:paste_preview_step_6=pasted_steps

0 scenario sequencer
50 capture screen pattern_focus

# Move to Step, then hold NAV without rotation through the selection timeout.
150 button NAV down
210 encoder NAV 1
270 button NAV up
350 capture screen step_focus
450 button NAV down
1510 tick
1570 button NAV up
1800 capture screen step_selection_entered

# Select visible step 3 with its macro button.
1900 tap MACRO_3 60
2100 capture screen step_3_selected

# Move cursor to step 5 and select it, leaving step 4 unselected.
2200 encoder NAV 2
2400 capture screen cursor_step_5
2500 tap MACRO_5 60
2700 capture screen steps_3_5_selected

# Long-pressing a Macro while selection is active must not open Step Editor.
2800 button MACRO_3 down
3870 tick
3930 capture screen selection_blocks_step_edit_open
3980 button MACRO_3 up
4180 capture screen selection_still_active_after_macro_hold

# Copy the sparse selection, move to step 6, preview its 6/8 footprint, paste.
4280 tap BOTTOM_RIGHT 60
4530 capture screen steps_copied
4630 encoder NAV 1
4830 capture screen paste_footprint_step_6
4930 button BOTTOM_RIGHT down
5130 capture screen paste_preview_step_6
6000 tick
6060 capture screen paste_hold_armed
6110 button BOTTOM_RIGHT up
6360 capture screen pasted_steps
