# UX workflow: enter Step selection from the semantic action selector.
# Purpose: validates the explicit LEFT_BOTTOM Select action, immediate selection
# feedback, sparse copy footprint, paste preview, and one complete paste action.
# Expect: capture_changed:step_selection_entered=steps_3_5_selected, capture_changed:paste_preview_step_6=pasted_steps

0 scenario sequencer
50 capture screen pattern_focus

# Move to Step, then choose Select steps from the LEFT_BOTTOM semantic selector.
150 tap NAV 60
350 capture screen step_focus
450 button LEFT_BOTTOM down
650 capture screen variation_action_selected
750 encoder NAV 1
800 encoder NAV 1
850 encoder NAV 1
900 encoder NAV 1
950 capture screen select_steps_action_selected
1000 button LEFT_BOTTOM up
1250 capture screen step_selection_entered

# Select visible step 3 with its macro button.
1350 tap MACRO_3 60
1550 capture screen step_3_selected

# Move cursor to step 5 and select it, leaving step 4 unselected.
1650 encoder NAV 2
1850 capture screen cursor_step_5
1950 tap MACRO_5 60
2150 capture screen steps_3_5_selected

# Long-pressing a Macro while selection is active must not open Step Editor.
2250 button MACRO_3 down
3320 tick
3380 capture screen selection_blocks_step_edit_open
3430 button MACRO_3 up
3630 capture screen selection_still_active_after_macro_hold

# Copy the sparse selection, move to step 6, preview its 6/8 footprint, paste.
3730 tap BOTTOM_RIGHT 60
3980 capture screen steps_copied
4080 encoder NAV 1
4280 capture screen paste_footprint_step_6
4380 button BOTTOM_RIGHT down
4580 capture screen paste_preview_step_6
5450 tick
5510 capture screen paste_hold_armed
5560 button BOTTOM_RIGHT up
5810 capture screen pasted_steps
