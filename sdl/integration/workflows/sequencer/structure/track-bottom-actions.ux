# UX workflow: Track mute/remove actions inside Structure.
# Purpose: validates that Track current-item and selection actions share one
# explicit structural surface: tap toggles mute, hold removes selected Tracks.
# Expect: capture_changed:track_2_created=track_2_muted_by_tap, capture_match:track_2_created=track_2_unmuted_by_tap, capture_changed:track_selection_unmuted_by_tap=track_selection_remove_hold_applied

0 scenario sequencer
50 capture screen pattern_focus_initial

# Open Structure and create Track 2 from the sole +Track slot. Creation enters
# its Pattern list; Back returns to Tracks while preserving Track 2 as active.
150 button NAV down
1220 tick
1280 button NAV up
1480 encoder NAV 1
1680 capture screen track_2_add_preview
1780 tap NAV 60
2130 capture screen track_2_patterns_open
2230 tap LEFT_TOP 60
2480 capture screen track_2_created

# Current Track action: tap toggles mute, a second tap restores it.
2580 tap BOTTOM_LEFT 60
2830 capture screen track_2_muted_by_tap
2930 tap BOTTOM_LEFT 60
3180 capture screen track_2_unmuted_by_tap

# Structure LEFT_CENTER enters Track selection. Select Track 2, exercise mute,
# then hold Remove; Track 1 remains as the valid project root.
3280 tap LEFT_CENTER 60
3530 capture screen track_selection_entered
3630 tap NAV 60
3880 capture screen track_2_selected
3980 tap BOTTOM_LEFT 60
4230 capture screen track_selection_muted_by_tap
4330 tap BOTTOM_LEFT 60
4580 capture screen track_selection_unmuted_by_tap
4680 button BOTTOM_LEFT down
5730 tick
5780 capture screen track_selection_remove_hold_applied
5830 button BOTTOM_LEFT up
6080 capture screen track_selection_removed
