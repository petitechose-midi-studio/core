# UX workflow: create sequencer pages, select non-contiguous pages, and preview
# cursor-anchored duplication destinations.

0 scenario sequencer
50 capture screen track_focus

# Enter page focus from the default track focus.
150 tap NAV 60
350 capture screen page_focus

# Create page 2 from the first add-slot preview.
450 encoder NAV 1
550 capture screen page_2_add_preview
650 tap NAV 60
850 capture screen page_2_created

# Create page 3 from the next add-slot preview.
950 encoder NAV 1
1050 capture screen page_3_add_preview
1150 tap NAV 60
1350 capture screen page_3_created

# Create page 4.
1450 encoder NAV 1
1550 capture screen page_4_add_preview
1650 tap NAV 60
1850 capture screen page_4_created

# Create page 5.
1950 encoder NAV 1
2050 capture screen page_5_add_preview
2150 tap NAV 60
2350 capture screen page_5_created

# Enter page selection mode on page 5.
2450 button NAV down
3500 tick
3550 capture screen selection_mode_entered
3600 button NAV up

# Select page 5, then page 1 and page 3, preserving gaps.
3750 tap NAV 60
3950 capture screen page_5_selected
4050 encoder NAV -1
4150 encoder NAV -1
4250 encoder NAV -1
4350 encoder NAV -1
4550 capture screen selection_cursor_page_1
4650 tap NAV 60
4850 capture screen pages_1_and_5_selected
4950 encoder NAV 1
5050 encoder NAV 1
5250 capture screen selection_cursor_page_3
5350 tap NAV 60
5550 capture screen pages_1_3_5_selected

# Move cursor to page 4. Preview should show page 4 as overwrite and pages 6/8
# as free destinations.
5650 encoder NAV 1
5850 capture screen duplicate_preview_overwrite_and_free

# Trigger duplicate selection.
5950 tap BOTTOM_RIGHT 60
6200 capture screen selection_duplicated
