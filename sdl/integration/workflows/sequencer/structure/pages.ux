# UX workflow: create sequencer pages, select non-contiguous pages, and preview
# cursor-anchored duplication destinations.

0 scenario sequencer
50 capture screen sequencer_ready

# Create page 2 from the first add-slot preview.
150 encoder NAV 1
250 capture screen page_2_add_preview
350 tap NAV 60
550 capture screen page_2_created

# Create page 3 from the next add-slot preview.
650 encoder NAV 1
750 capture screen page_3_add_preview
850 tap NAV 60
1050 capture screen page_3_created

# Create page 4.
1150 encoder NAV 1
1250 capture screen page_4_add_preview
1350 tap NAV 60
1550 capture screen page_4_created

# Create page 5.
1650 encoder NAV 1
1750 capture screen page_5_add_preview
1850 tap NAV 60
2050 capture screen page_5_created

# Enter page selection mode on page 5.
2150 button NAV down
3200 tick
3250 capture screen selection_mode_entered
3300 button NAV up

# Select page 5, then page 1 and page 3, preserving gaps.
3450 tap NAV 60
3650 capture screen page_5_selected
3750 encoder NAV -1
3850 encoder NAV -1
3950 encoder NAV -1
4050 encoder NAV -1
4250 capture screen selection_cursor_page_1
4350 tap NAV 60
4550 capture screen pages_1_and_5_selected
4650 encoder NAV 1
4750 encoder NAV 1
4950 capture screen selection_cursor_page_3
5050 tap NAV 60
5250 capture screen pages_1_3_5_selected

# Move cursor to page 4. Preview should show page 4 as overwrite and pages 6/8
# as free destinations.
5350 encoder NAV 1
5550 capture screen duplicate_preview_overwrite_and_free

# Trigger duplicate selection.
5650 tap BOTTOM_RIGHT 60
5900 capture screen selection_duplicated
