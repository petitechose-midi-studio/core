# UX workflow: copy/paste a track containing chord step content.
# Purpose: validates that track clipboard preserves the full sequencer graph,
# including local chord state attached to root step nodes.
# The direct Track preview and committed Track surface are intentionally distinct.
# Expect: capture_changed:track_2_paste_preview=track_2_chord_pasted
# Expect: semantic:track_2_paste_pressed:surface_context=true
# Expect: semantic:track_2_paste_pressed:effect=arm_paste_current_structure
# Expect: semantic:track_2_paste_pressed:route_policy=preserve_destination
# Expect: semantic:track_2_paste_pressed:source_mask=1, semantic:track_2_paste_pressed:target_mask=2
# Expect: semantic:track_2_paste_hold_applied:effect=arm_paste_current_structure
# Expect: semantic:track_2_paste_hold_applied:target_route_valid=true
# Expect: semantic:track_2_paste_hold_applied:outcome=applied
# Expect: semantic:track_2_paste_hold_applied:activation_origin=track_paste
# Expect: semantic:track_2_paste_hold_applied:activation_generation=*
# Expect: capture_changed:track_paste_summary=track_paste_details_1
# Expect: capture_changed:track_paste_armed_cancel=track_paste_cancelled, capture_changed:track_paste_queued=track_paste_applied
# Expect: semantic:track_paste_summary:surface_context=true, semantic:track_paste_summary:outcome=preview
# Expect: semantic:track_paste_summary:source_mask=1, semantic:track_paste_summary:target_mask=16
# Expect: semantic:track_paste_summary:create_mask=0, semantic:track_paste_summary:overwrite_mask=16
# Expect: semantic:track_paste_summary:route_policy=preserve_destination, semantic:track_paste_summary:mapping_count=1
# Expect: semantic:track_paste_summary:mapping_index=0, semantic:track_paste_summary:source_track=0
# Expect: semantic:track_paste_summary:target_track=4, semantic:track_paste_summary:target_kind=overwrite
# Expect: semantic:track_paste_summary:target_route=8, semantic:track_paste_summary:target_route_valid=true
# Expect: semantic:track_paste_summary:inherited_lane_count=1, semantic:track_paste_summary:pinned_lane_count=1
# Expect: semantic:track_paste_armed_cancel:outcome=armed, semantic:track_paste_armed_cancel:operation_status=armed
# Expect: semantic:track_paste_cancelled:outcome=cancelled, semantic:track_paste_cancelled:operation_status=cancelled
# Expect: semantic:track_paste_queued:outcome=queued, semantic:track_paste_queued:operation_status=queued
# Expect: semantic:track_paste_queued:operation_origin=track_paste, semantic:track_paste_queued:operation_generation=*
# Expect: semantic:track_paste_queued:activation_origin=track_paste, semantic:track_paste_queued:activation_generation=*
# Expect: semantic:track_paste_applied:outcome=applied, semantic:track_paste_applied:operation_status=applied
# Expect: semantic:track_paste_applied:operation_origin=track_paste, semantic:track_paste_applied:operation_generation=*
# Expect: semantic:track_paste_applied:activation_origin=track_paste, semantic:track_paste_applied:activation_generation=*

0 scenario sequencer
50 capture screen sequencer_ready

# Enter Step focus, enable step 1, and create a local chord from the Step Editor.
150 capture screen pattern_focus
450 button NAV down
510 encoder NAV 1
570 button NAV up
650 capture screen step_focus
750 tap MACRO_1 60
950 capture screen step_1_enabled
1050 button MACRO_1 down
2100 tick
2150 capture screen step_editor_open
2200 button MACRO_1 up
2300 encoder NAV 1
2380 encoder NAV 1
2460 encoder NAV 1
2540 encoder NAV 1
2620 encoder NAV 1
2700 encoder NAV 1
2900 capture screen chord_row_single
3000 tap NAV 60
3160 encoder OPT 1.0
3300 capture screen chord_row_local
3320 tap BOTTOM_RIGHT 40
3400 tap NAV 60
3500 tap LEFT_TOP 60
3700 capture screen source_track_chord_badge

# Switch the NAV context directly to Tracks, copy Track 1, then paste it into
# the next empty Track slot.
3800 button NAV down
3860 encoder NAV 1
3920 button NAV up
5000 capture screen track_focus_source
5050 tap BOTTOM_RIGHT 60
5200 capture screen track_1_chord_copied
5250 encoder NAV 1
5400 capture screen track_2_paste_preview
5450 button BOTTOM_RIGHT down
5550 capture screen track_2_paste_pressed
6500 tick
6520 capture screen track_2_paste_hold_applied
6550 button BOTTOM_RIGHT up
6700 capture screen track_2_chord_pasted

# Prepare a deterministic direct Track proof surface. T1 is the source and T5
# is a muted overwrite destination on Ch9. The source owns one inherited and
# one pinned CC lane.
6800 scenario seq-track-paste-single
6950 capture screen track_paste_source

# Start transport before a compatible clipboard exists. Once the paste plan is
# visible, BOTTOM_CENTER becomes Details and must never toggle transport.
7050 tap BOTTOM_CENTER 60
7250 capture screen track_paste_transport_playing

# Copy T1, then move the sparse Track cursor to T5.
7350 tap BOTTOM_RIGHT 60
7550 capture screen track_paste_track_copied
7650 encoder NAV 1
7730 encoder NAV 1
7810 encoder NAV 1
7890 encoder NAV 1
8150 capture screen track_paste_summary

# Details exposes the exact direct mapping while keeping the paste anchor fixed.
8250 tap BOTTOM_CENTER 60
8450 capture screen track_paste_details_1
8750 tap BOTTOM_CENTER 60
9050 capture screen track_paste_summary_restored

# An armed release is explicitly non-mutating and leaves a short Cancelled
# confirmation before restoring the same preflight.
9150 button BOTTOM_RIGHT down
9250 capture screen track_paste_pressed_cancel
9500 tick
9550 capture screen track_paste_armed_cancel
9750 button BOTTOM_RIGHT up
9950 capture screen track_paste_cancelled
10900 capture screen track_paste_preview_after_cancel

# A complete hold commits once. With transport running, editor changes remain
# Queued until the exact activation batch is published at the loop boundary.
11100 button BOTTOM_RIGHT down
11250 capture screen track_paste_pressed_commit
11450 capture screen track_paste_armed_commit
12120 tick
12140 scenario seq-track-paste-project-queued
12160 capture screen track_paste_queued
12220 button BOTTOM_RIGHT up

# SDL may cross the local-loop boundary inside one capture frame. These two
# projections preserve the exact plan and operation ID from the real commit,
# with one correlated capture generation making Queued -> Applied provable.
12320 scenario seq-track-paste-project-applied
12520 capture screen track_paste_applied
