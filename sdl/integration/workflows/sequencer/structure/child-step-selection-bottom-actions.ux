# UX workflow: child-context step selection bottom actions.
# Purpose: verifies that step-selection copy/paste plus shallow/deep reset work
# inside a micro-sequence content view, not only at root pattern level.
# Expect: capture_changed:child_steps_1_2_selected=child_selection_tap_shallow_reset, capture_changed:child_paste_preview_cursor_1=child_selection_pasted

0 scenario sequencer
50 capture screen sequencer_ready

# Create a micro-sequence child context on root step 1.
150 tap MACRO_1 60
350 capture screen root_step_enabled
450 button MACRO_1 down
1500 tick
1550 capture screen root_step_editor_open
1600 button MACRO_1 up
1700 encoder NAV 1
1780 encoder NAV 1
1860 encoder NAV 1
1940 encoder NAV 1
2020 encoder NAV 1
2100 encoder NAV 1
2180 encoder NAV 1
2260 capture screen micro_row_focused
2360 tap NAV 60
2660 capture screen child_pattern_focus

# Selection Copy owns BOTTOM_RIGHT only after the new child has been published;
# while it is a draft that same slot is deliberately Apply.
2680 tap BOTTOM_RIGHT 40

# Move to child Step context. A newly published micro-sequence already owns two
# active child steps; do not toggle either one while preparing the selection.
2760 button NAV down
2820 encoder NAV 1
2880 button NAV up
2960 capture screen child_step_focus
3660 capture screen child_steps_1_2_enabled

# Enter child Step selection through the same stationary NAV hold as root.
# LEFT_TOP remains exclusively Back in the child context.
3760 button NAV down
4820 tick
4880 button NAV up
5130 capture screen child_step_selection_entered
5230 tap MACRO_1 60
5480 capture screen child_step_1_selected
5580 encoder NAV 1
5780 capture screen child_selection_cursor_2
5880 tap MACRO_2 60
6130 capture screen child_steps_1_2_selected
6230 tap BOTTOM_RIGHT 60
6480 capture screen child_step_selection_copied
6580 tap BOTTOM_LEFT 60
6830 capture screen child_selection_tap_shallow_reset
6930 button BOTTOM_LEFT down
7980 tick
8030 capture screen child_selection_deep_reset_hold_applied
8080 button BOTTOM_LEFT up
8330 capture screen child_selection_deep_reset_released

# Paste the copied footprint back from cursor step 1.
8430 encoder NAV -1
8630 capture screen child_paste_preview_cursor_1
8730 button BOTTOM_RIGHT down
9780 tick
9830 capture screen child_paste_hold_applied
9880 button BOTTOM_RIGHT up
10130 capture screen child_selection_pasted
