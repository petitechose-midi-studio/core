# Empty Clip -> Pattern -> Pattern Presets uses the existing Pattern-owned
# editor and exact one-level Back grammar; the Launcher adds no second browser.
# Expect: capture_changed:launcher_empty=empty_drum_pattern
# Expect: capture_changed:empty_drum_pattern=pattern_editor
# Expect: capture_changed:pattern_editor=pattern_library
# Expect: capture_match:pattern_editor=pattern_editor_returned
# Expect: capture_changed:pattern_editor_returned=pattern_returned
# Expect: capture_changed:pattern_returned=launcher_returned
# Expect: semantic:empty_drum_pattern:effect=create_clip_and_open_pattern, semantic:empty_drum_pattern:target_track=1, semantic:empty_drum_pattern:target_index=1
# Expect: semantic:pattern_library:mode=sequencer.pattern_preset.load, semantic:pattern_library:target=pattern
# Expect: semantic:launcher_returned:effect=return_to_clip_launcher, semantic:launcher_returned:target_track=1, semantic:launcher_returned:target_index=1

0 scenario clip-launcher
100 tap MACRO_6 60
260 capture screen launcher_empty

# NAV creates the empty Drum Clip and enters its Pattern workspace.
360 tap NAV 60
700 capture screen empty_drum_pattern

# Pattern owns its existing editor; a held NAV opens the shared Pattern library.
800 tap NAV 60
1150 capture screen pattern_editor
1250 button NAV down
2310 tick
2370 capture screen pattern_library
2430 button NAV up

# Back unwinds Library -> Pattern editor -> Pattern -> exact Launcher cell.
2540 tap LEFT_TOP 60
2850 capture screen pattern_editor_returned
2950 tap LEFT_TOP 60
3260 capture screen pattern_returned
3360 tap LEFT_TOP 60
3700 capture screen launcher_returned
