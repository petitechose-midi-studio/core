# UX workflow: Clip Launcher quick property selector.
# Purpose: proves LEFT_CENTER defaults to Edit, held LEFT_CENTER + NAV selects
# Loops, release arms it, and OPT edits it without leaving performance view.
# Expect: capture_changed:quick_edit=clip_focused
# Expect: capture_changed:quick_length=quick_edit
# The selected value remains visible briefly after release while OPT is armed.
# Expect: capture_match:length_armed=quick_length
# Expect: capture_changed:length_changed=length_armed
# Expect: semantic:quick_length:effect=select_clip_quick_action, semantic:quick_length:property=length
# Expect: semantic:length_armed:effect=arm_clip_quick_property, semantic:length_armed:property=length
# Expect: semantic:length_changed:effect=edit_clip_quick_property, semantic:length_changed:property=length
# Follow reuses the same gesture and exposes semantic choices rather than raw
# slot arithmetic.
# Expect: capture_changed:quick_follow=length_changed
# Expect: capture_match:follow_armed=quick_follow
# Expect: capture_changed:follow_next=follow_armed
# Expect: semantic:quick_follow:effect=select_clip_quick_action, semantic:quick_follow:property=follow
# Expect: semantic:follow_armed:effect=arm_clip_quick_property, semantic:follow_armed:property=follow
# Expect: semantic:follow_next:effect=edit_clip_quick_property, semantic:follow_next:property=follow
# Opening the full editor reads the authored value back from the Clip domain.
# Expect: capture_changed:behavior_follow=follow_next
# Expect: semantic:behavior_follow:target=clip_behavior, semantic:behavior_follow:property=follow, semantic:behavior_follow:value_label=next

0 scenario clip-launcher-v3

# Scene -> first Clip.
100 button NAV down
180 encoder NAV 0.01
260 button NAV up
420 capture screen clip_focused

# LEFT_CENTER opens on Edit; held NAV moves to Loops.
500 button LEFT_CENTER down
620 capture screen quick_edit
700 encoder NAV 0.01
820 capture screen quick_length
900 button LEFT_CENTER up
1020 capture screen length_armed

1100 encoder OPT 0.01
1260 capture screen length_changed

1400 button LEFT_CENTER down
1500 encoder NAV 0.01
1600 encoder NAV 0.01
1700 capture screen quick_follow
1780 button LEFT_CENTER up
1900 capture screen follow_armed
1980 encoder OPT 0.01
2140 capture screen follow_next

3000 tap LEFT_CENTER 60
3300 encoder NAV 0.01
3460 capture screen behavior_follow
