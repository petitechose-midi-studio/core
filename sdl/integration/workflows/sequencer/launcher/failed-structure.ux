# UX workflow: Scene behavior and live Scene scheduling.
# Purpose: validates the row-level editor, atomic Scene queue, same-Scene
# cancellation, latest-Scene replacement, countdown and mixed Clip/Stop apply.
# Expect: capture_changed:scene_ready=launcher_ready
# Expect: capture_changed:scene_behavior=scene_ready
# Expect: capture_changed:scene_returned=scene_behavior
# Expect: capture_changed:scene_queued=scene_returned
# Expect: capture_changed:scene_queue_cancelled=scene_queued
# Expect: capture_changed:scene_replaced=scene_queue_cancelled
# Expect: capture_changed:scene_countdown=scene_replaced
# Expect: capture_changed:scene_applied=scene_countdown
# Expect: semantic:scene_ready:target=scene, semantic:scene_ready:target_index=1, semantic:scene_ready:projection=scene_rail
# Expect: semantic:scene_behavior:mode=sequencer.clip_launcher.editor, semantic:scene_behavior:target=scene_behavior, semantic:scene_behavior:value_label=2_bars
# Expect: semantic:scene_queued:operation_origin=manual_scene, semantic:scene_queued:operation_status=queued, semantic:scene_queued:queued_slot=1, semantic:scene_queued:beats_remaining=4
# Expect: semantic:scene_queue_cancelled:operation_status=cancelled
# Expect: semantic:scene_replaced:operation_origin=manual_scene, semantic:scene_replaced:queued_slot=2, semantic:scene_replaced:beats_remaining=2
# Expect: semantic:scene_countdown:queued_slot=2, semantic:scene_countdown:beats_remaining=1
# Expect: semantic:scene_applied:operation_status=applied, semantic:scene_applied:active_slot=2, semantic:scene_applied:property=active

0 scenario clip-launcher-v3
100 capture screen launcher_ready

# Scene is the default performance focus; one turn selects Scene 2.
220 encoder OPT 0.01
620 capture screen scene_ready

# LEFT_CENTER opens the authored two-bar Scene behavior.
700 tap LEFT_CENTER 60
1840 capture screen scene_behavior
2080 tap LEFT_TOP 60
2260 capture screen scene_returned

# While transport runs, Scene 2 is queued on the next bar. Pressing it again
# cancels the exact request; a newer Scene replaces the older request.
2340 tap BOTTOM_CENTER 60
2520 tap NAV 60
2700 capture screen scene_queued
2780 tap NAV 60
2960 capture screen scene_queue_cancelled
3040 tap NAV 60
3200 encoder OPT 0.01
3280 tap NAV 60
3460 capture screen scene_replaced

# Countdown remains visible until the shared boundary. Scene 3 applies Clips
# on T1/T3 and an authored Stop on T2 as one musical action.
4140 capture screen scene_countdown
4860 capture screen scene_applied
5040 tap BOTTOM_CENTER 60
