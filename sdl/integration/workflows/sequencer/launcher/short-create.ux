# UX workflow: direct Clip and trailing Scene creation.
# Purpose: proves that a short NAV press on an Empty Clip opens the existing
# Create action, while the trailing +Scene routes to the first enabled Track
# on that row instead of introducing a separate Scene object.
# Expect: capture_changed:empty_clip=launcher_ready
# Expect: capture_changed:create_clip=empty_clip
# Expect: capture_changed:clip_created=create_clip
# Expect: capture_changed:add_scene=clip_created
# Expect: capture_changed:create_scene_clip=add_scene
# Expect: capture_changed:scene_created=create_scene_clip
# Expect: semantic:create_clip:effect=open_slot_actions, semantic:create_clip:target_track=2, semantic:create_clip:target_index=3
# Expect: semantic:clip_created:effect=apply_slot_action, semantic:clip_created:outcome=applied
# Expect: semantic:create_scene_clip:effect=open_slot_actions, semantic:create_scene_clip:target_track=0, semantic:create_scene_clip:target_index=4
# Expect: semantic:scene_created:effect=apply_slot_action, semantic:scene_created:outcome=applied

0 scenario clip-launcher-v3
100 capture screen launcher_ready

# Scene rail -> S4, then horizontal browsing -> Empty T3/S4.
220 encoder OPT 0.01
300 encoder OPT 0.01
380 encoder OPT 0.01
540 encoder NAV 0.01
620 encoder NAV 0.01
700 encoder NAV 0.01
940 capture screen empty_clip

# Short NAV opens Create; a second press applies it.
1020 tap NAV 60
1300 capture screen create_clip
1380 tap NAV 60
1660 capture screen clip_created

# Move back to the Scene rail, then down into the trailing +Scene row.
1820 encoder NAV -0.01
1900 encoder NAV -0.01
1980 encoder NAV -0.01
2140 encoder OPT 0.01
2300 capture screen add_scene

# The row becomes a Scene when its first Clip is created.
2380 tap NAV 60
2660 capture screen create_scene_clip
2740 tap NAV 60
3020 capture screen scene_created
