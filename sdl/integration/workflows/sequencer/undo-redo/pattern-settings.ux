# UX workflow: change pattern pitch settings, then undo and redo the change.
# Purpose: validates pattern pitch settings participate in sequencer history.
# Expect: capture_changed:pattern_pitch_override_applied=pattern_settings_undone_inspected, capture_match:pattern_pitch_override_applied=pattern_settings_redone_inspected

0 scenario sequencer
50 capture screen sequencer_ready

# Open the pitch property settings from the NOTE property selector.
60 tap NAV 60
150 button LEFT_BOTTOM down
300 capture screen pitch_property_selector_open
400 tap BOTTOM_LEFT 60
520 button LEFT_BOTTOM up
700 capture screen pattern_pitch_settings_inherit

# Switch the pattern from inherited project scale to local override.
800 tap NAV 60
900 encoder NAV 1
1050 capture screen pattern_pitch_override_selector
1150 tap NAV 60
1350 capture screen pattern_pitch_override_applied

# Return to the sequencer view.
1450 tap LEFT_TOP 60
1750 capture screen sequencer_after_pattern_settings

# Undo the pattern setting.
1850 button LEFT_CENTER down
2850 tick
2900 capture screen undo_layer
2950 tap LEFT_TOP 60
4450 capture screen pattern_settings_undone_toast
4550 button LEFT_CENTER up
5850 capture screen pattern_settings_undone_closed

# Reopen the pitch settings to verify that undo restored Inherit explicitly.
5950 button LEFT_BOTTOM down
6100 tap BOTTOM_LEFT 60
6220 button LEFT_BOTTOM up
6500 capture screen pattern_settings_undone_inspected
6600 tap LEFT_TOP 60

# Redo the pattern setting.
6850 button LEFT_CENTER down
7850 tick
7900 capture screen redo_layer
7950 tap LEFT_BOTTOM 60
9450 capture screen pattern_settings_redone_toast
9550 button LEFT_CENTER up
10850 capture screen pattern_settings_redone_closed

# Reopen once more: redo must restore the exact Override state.
10950 button LEFT_BOTTOM down
11100 tap BOTTOM_LEFT 60
11220 button LEFT_BOTTOM up
11500 capture screen pattern_settings_redone_inspected
