# UX workflow: toggle a sequencer step, then undo and redo the toggle through
# the held LEFT_CENTER history layer.
# Purpose: validates step toggle history entry creation and transient undo/redo
# routing from the sequencer grid.
# Expect: capture_match:sequencer_ready=undo_layer_closed, capture_match:step_toggled_on=redo_layer_closed

0 scenario sequencer
50 capture screen sequencer_ready

# Toggle the first visible step on.
150 tap MACRO_1 60
350 capture screen step_toggled_on

# Undo the toggle.
450 button LEFT_CENTER down
1450 tick
1500 capture screen undo_layer
1550 tap LEFT_TOP 60
3050 capture screen step_toggle_undone
3150 button LEFT_CENTER up
3350 capture screen undo_layer_closed

# Redo the toggle.
3450 button LEFT_CENTER down
4450 tick
4500 capture screen redo_layer
4550 tap LEFT_BOTTOM 60
6050 capture screen step_toggle_redone
6150 button LEFT_CENTER up
6350 capture screen redo_layer_closed
