# UX workflow: edit a pattern variation range, then undo and redo it through the
# global View Selector.
# Purpose: validates variation range changes create one undoable pattern entry.
# Expect: capture_changed:range_applied_closed=range_undone_closed, capture_match:range_applied_closed=range_redone_closed
# Expect: semantic:property_selector_open:mode=sequencer.property_selector, semantic:velocity_range_adjusted:effect=edit_variation_range, semantic:velocity_range_adjusted:mode=sequencer.property_selector
# Expect: semantic:selector_undo_ready:mode=view_selector, semantic:selector_redo_ready:effect=undo_project_action, semantic:selector_redo_ready:intent=undo
# Expect: semantic:range_undone_closed:mode=sequencer.pattern, semantic:selector_redo_ready_again:mode=view_selector
# Expect: semantic:selector_undo_restored:effect=redo_project_action, semantic:selector_undo_restored:intent=redo, semantic:range_redone_closed:mode=sequencer.pattern

0 scenario sequencer
50 capture screen sequencer_ready

# Create an enabled step so the visible grid has a stable anchor.
150 tap MACRO_1 60
350 capture screen step_enabled

# Hold LEFT_BOTTOM, select Velocity, and set its variation range.
450 button LEFT_BOTTOM down
600 capture screen property_selector_open
700 encoder NAV 0.01
800 encoder OPT 1.00
950 capture screen velocity_range_adjusted
1050 button LEFT_BOTTOM up
# Return to the grid so applied, undone, and redone states are compared on the
# same musical surface.
1900 capture screen range_applied_closed

# Undo the range change.
2000 tap LEFT_TOP 60
2200 tap LEFT_TOP 60
3000 tick
3050 capture screen selector_undo_ready
3100 tap LEFT_CENTER 60
4600 capture screen selector_redo_ready
4700 tap LEFT_TOP 60
4900 tap LEFT_BOTTOM 60
6000 capture screen range_undone_closed

# Redo the range change.
6100 tap LEFT_TOP 60
6300 tap LEFT_TOP 60
7100 tick
7150 capture screen selector_redo_ready_again
7200 tap LEFT_BOTTOM 60
8700 capture screen selector_undo_restored
8800 tap LEFT_TOP 60
9000 tap LEFT_BOTTOM 60
10100 capture screen range_redone_closed
