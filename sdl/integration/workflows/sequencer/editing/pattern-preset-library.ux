# UX workflow: Pattern Preset Factory/User library from Pattern Editor.
# Purpose: validates the shared library shell, Pattern-specific source filter,
# immutable Factory detail, reversible stopped preview, and explicit confirm.
# Expect: capture_changed:pattern_preset_all=pattern_preset_factory, capture_changed:pattern_preset_factory=pattern_preset_factory_category, capture_changed:pattern_preset_factory_category=pattern_preset_detail, capture_changed:pattern_preset_detail=pattern_preset_preview, capture_changed:pattern_preset_preview=pattern_preset_confirmed
# Expect: semantic:pattern_preset_factory:effect=cycle_pattern_preset_source, semantic:pattern_preset_factory:property=source_filter, semantic:pattern_preset_factory:value_label=factory
# Expect: semantic:pattern_preset_factory_category:effect=enter_pattern_preset_folder, semantic:pattern_preset_factory_category:mode=sequencer.pattern_preset.load
# Expect: semantic:pattern_preset_detail:effect=enter_preset_library_detail, semantic:pattern_preset_detail:mode=sequencer.pattern_preset.load.detail, semantic:pattern_preset_detail:target=pattern
# Expect: semantic:pattern_preset_preview:mode=sequencer.pattern_preset.preview, semantic:pattern_preset_preview:outcome=ready, semantic:pattern_preset_preview:route_policy=preserve_destination, semantic:pattern_preset_preview:projection=provisional
# Expect: semantic:pattern_preset_confirmed:effect=confirm_pattern_preset_preview, semantic:pattern_preset_confirmed:outcome=ready

0 scenario sequencer

# Pattern focus opens the retained Pattern Editor.
100 tap NAV 60

# NAV hold opens the Pattern library. The matching release is consumed.
300 button NAV down
1400 tick
1450 capture screen pattern_preset_all
1500 button NAV up

# LEFT_CENTER cycles All -> Factory without changing musical state.
1750 tick
1850 tap LEFT_CENTER 60
2050 capture screen pattern_preset_factory

# NAV enters the selected Factory category, then the common read-only detail.
2150 tap NAV 60
2350 capture screen pattern_preset_factory_category
2450 tap NAV 60
2650 capture screen pattern_preset_detail
2750 tap LEFT_TOP 60

# BOTTOM_RIGHT starts a reversible audition on the parent grid. The same
# physical action confirms it exactly once through the normal Pattern history.
2950 tap BOTTOM_RIGHT 60
3150 capture screen pattern_preset_preview
3350 tap BOTTOM_RIGHT 60
3550 capture screen pattern_preset_confirmed
