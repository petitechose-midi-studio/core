# UX workflow: edit a root step chord from the Step Editor.
# Purpose: captures the Chord row, live OPT feedback, and the resulting grid badge.

0 scenario sequencer
50 capture screen sequencer_ready

# Move to Step focus, enable step 1, and open the Step Editor.
150 tap NAV 60
350 capture screen pattern_focus
450 tap NAV 60
650 capture screen step_focus
750 tap MACRO_1 60
950 capture screen step_1_enabled
1050 button MACRO_1 down
2100 tick
2150 capture screen step_editor_open
2200 button MACRO_1 up

# Focus Chord and turn OPT to create a local chord.
2300 encoder NAV 1
2380 encoder NAV 1
2460 encoder NAV 1
2540 encoder NAV 1
2620 encoder NAV 1
2700 encoder NAV 1
2900 capture screen chord_row_single
3000 encoder OPT 1.0
3300 capture screen chord_row_local

# NAV opens the detailed chord editor; NAV turns select chord fields.
3400 tap NAV 60
3650 capture screen chord_detail_mode
3750 encoder NAV 1
3900 capture screen chord_detail_voices
4000 encoder NAV 1
4150 capture screen chord_detail_color
4250 encoder OPT 1.0
4450 capture screen chord_detail_color_adjusted

# Close the detail, then close the editor and reveal the chord badge on the step tile.
4550 tap NAV 60
4750 capture screen chord_row_after_detail
4850 tap LEFT_TOP 60
5150 capture screen chord_badge_on_grid

# Reopen the root editor, create a micro-sequence, and verify that a child step
# in Inherit mode previews the parent chord.
5250 button MACRO_1 down
6300 tick
6350 capture screen root_chord_editor_reopened
6400 button MACRO_1 up
6500 encoder NAV 1
6580 encoder NAV 1
6660 encoder NAV 1
6740 encoder NAV 1
6820 encoder NAV 1
6900 encoder NAV 1
6980 encoder NAV 1
7100 capture screen root_micro_row_for_inherit
7200 tap NAV 60
7500 capture screen child_context_after_chord_parent
7600 button MACRO_1 down
8650 tick
8700 capture screen child_step_editor_open
8750 button MACRO_1 up
8850 encoder NAV 1
8930 encoder NAV 1
9010 encoder NAV 1
9090 encoder NAV 1
9170 encoder NAV 1
9250 encoder NAV 1
9450 capture screen child_chord_row_inherit
9550 tap NAV 60
9850 capture screen child_chord_detail_inherit
