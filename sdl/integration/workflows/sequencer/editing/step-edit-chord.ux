# UX workflow: author one scale-aware chord, invert it, and widen its voicing.
# Purpose: prove that the current Shape -> Formula -> Inversion -> Voicing
# grammar edits semantic intent and publishes the completed Chord draft.
# Expect: capture_changed:shape_triad=shape_sus4, capture_changed:inversion_root=inversion_first, capture_changed:voicing_close=voicing_wide, capture_changed:chord_row_single=chord_published
# Expect: semantic:shape_sus4:effect=edit_step_editor_row, semantic:shape_sus4:draft_active=true, semantic:shape_sus4:dirty=true
# Expect: semantic:formula_readable:draft_active=true, semantic:inversion_first:effect=edit_step_editor_row, semantic:inversion_first:value_label=1st
# Expect: semantic:voicing_wide:effect=edit_step_editor_row, semantic:voicing_wide:dirty=true
# Expect: semantic:chord_published:effect=resolve_draft_exit, semantic:chord_published:outcome=applied, semantic:chord_published:projection=published, semantic:chord_published:draft_active=false, semantic:chord_published:published=true

0 scenario sequencer
50 capture screen sequencer_ready

# Move to Step focus, enable step 1, and open the Step Editor.
150 capture screen pattern_focus
450 button NAV down
510 encoder NAV 1
570 button NAV up
650 capture screen step_focus
750 tap MACRO_1 60
950 capture screen step_1_enabled
1050 button MACRO_1 down
2100 tick
2150 capture screen step_editor_open
2200 button MACRO_1 up

# Focus Chord and create a readable three-voice local chord.
2300 encoder NAV 1
2380 encoder NAV 1
2460 encoder NAV 1
2540 encoder NAV 1
2620 encoder NAV 1
2700 encoder NAV 1
2900 capture screen chord_row_single
# NAV opens the transactional semantic editor on Shape. Choose a scale-aware
# Sus 4 shape, inspect its Formula, then set first inversion and Wide voicing.
3000 tap NAV 60
3300 capture screen chord_detail_mode
3400 capture screen shape_triad
3500 encoder OPT 1.0
3750 capture screen shape_sus4
3850 encoder NAV 1
4050 capture screen formula_readable
4150 encoder NAV 1
4350 capture screen inversion_root
4450 encoder OPT 1.0
4650 capture screen inversion_first
4750 encoder NAV 1
4950 capture screen voicing_close
5050 encoder OPT 2.0
5250 capture screen voicing_wide

# Back requests the transactional exit. NAV accepts the default Save choice;
# the completed Step-content draft is then published on the Chord row.
5350 tap LEFT_TOP 60
5600 capture screen chord_exit_save
5700 tap NAV 60
6000 capture screen chord_published
