# UX workflow: Drum Pattern Preset library from the Pattern Editor.
# Purpose: proves the shared Pattern library is owned by Pattern rather than
# Lane, filters Factory assets by Drum kind, and keeps
# stopped preview reversible before one explicit confirmation.
# Expect: capture_changed:drum_pattern_preset_all=drum_pattern_preset_factory, capture_changed:drum_pattern_preset_factory=drum_pattern_preset_factory_category, capture_changed:drum_pattern_preset_factory_category=drum_pattern_preset_detail, capture_changed:drum_pattern_preset_detail=drum_pattern_preset_preview, capture_changed:drum_pattern_preset_preview=drum_pattern_preset_confirmed
# Expect: semantic:drum_pattern_preset_detail:mode=sequencer.pattern_preset.load.detail, semantic:drum_pattern_preset_detail:target=pattern
# Expect: semantic:drum_pattern_preset_preview:mode=sequencer.pattern_preset.preview, semantic:drum_pattern_preset_preview:projection=provisional
# Expect: semantic:drum_pattern_preset_confirmed:effect=confirm_pattern_preset_preview, semantic:drum_pattern_preset_confirmed:outcome=ready

0 scenario drum-sequencer

# Create Track 2 as a General MIDI Drum Track from the Clip Launcher's add
# header, then author a visible phrase.
150 tap LEFT_TOP 60
500 encoder NAV -0.01
620 button LEFT_CENTER down
700 encoder NAV 0.01
780 button LEFT_CENTER up
1530 tap NAV 60
1830 encoder NAV 0.01
2300 tap NAV 60
3100 encoder NAV 0.01
3450 tap NAV 60

# Lane scope owns authoring and Lane movement.
4100 button NAV down
4160 encoder NAV 0.01
4220 button NAV up
4350 tap MACRO_1 60
4550 tap MACRO_5 60
5000 encoder NAV 0.01
5150 tap MACRO_3 60
5350 tap MACRO_7 60

# Return to Pattern, open its editor, then hold NAV for the shared Pattern library.
5450 button NAV down
5510 encoder NAV -0.01
5570 button NAV up
5650 tap NAV 60
5900 button NAV down
7000 tick
7050 capture screen drum_pattern_preset_all
7100 button NAV up

# Browse Factory > House > Four on the floor.
7350 tick
7450 tap LEFT_CENTER 60
7650 capture screen drum_pattern_preset_factory
7750 tap NAV 60
7950 capture screen drum_pattern_preset_factory_category
8050 tap NAV 60
8250 capture screen drum_pattern_preset_detail
8350 tap LEFT_TOP 60

# Audition on the Drum grid, then confirm once through the normal history path.
8550 tap BOTTOM_RIGHT 60
8750 capture screen drum_pattern_preset_preview
8950 tap BOTTOM_RIGHT 60
9150 capture screen drum_pattern_preset_confirmed
