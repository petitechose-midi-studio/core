# UX workflow: open sequencer quick controls, change selection/value, and apply.
# Purpose: validates held-button modal routing, quick-control selection, OPT
# editing, and release-to-apply semantics.
# Expect: capture_changed:quick_controls_open=quick_controls_offset, capture_changed:quick_controls_offset=quick_controls_adjusted

0 scenario sequencer
50 capture screen sequencer_ready

# Hold LEFT_CENTER to enter quick controls.
150 button LEFT_CENTER down
260 capture screen quick_controls_open

# Navigate through Offset to Division and change its value.
330 encoder NAV 1
400 capture screen quick_controls_offset
450 encoder NAV 1
520 encoder OPT 0.70
600 capture screen quick_controls_adjusted

# Release LEFT_CENTER to apply and close.
620 button LEFT_CENTER up
820 capture screen quick_controls_closed
