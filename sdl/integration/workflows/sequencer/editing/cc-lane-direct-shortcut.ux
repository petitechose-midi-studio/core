# UX workflow: property hold remains stable in the shared grammar.
# Purpose: guards against the removed LEFT_BOTTOM hold shortcut reopening the
# CC Lane panel and interfering with ordinary property selection.
# Expect: capture_changed:pattern_ready_track_scope=property_selector_hold_stable
# Expect: semantic:property_selector_hold_stable:mode=sequencer.property_selector, semantic:property_selector_hold_stable:overlay=none

0 scenario sequencer
80 capture screen pattern_ready_track_scope

# Enter Pattern, then hold the normal musical-property control for one second.
# The selector must remain where the user put it until release.
160 tap NAV 60
300 button LEFT_BOTTOM down
1340 tick
1420 capture screen property_selector_hold_stable
1500 button LEFT_BOTTOM up
