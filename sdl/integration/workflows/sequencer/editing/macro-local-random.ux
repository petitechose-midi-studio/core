# UX workflow: edit per-step local randomization from the sequencer grid with macros.
# Purpose: validates the contextual property grammar: LEFT_CENTER opens the
# Step property selector, then LEFT_BOTTOM + macro encoder writes the local
# variation range for the active property and previews it without editing the
# deterministic step value.
# Expect: capture_changed:prop_selector_ready=macro_local_random_pitch, capture_changed:macro_local_random_pitch=macro_local_random_closed

0 scenario sequencer
50 capture screen sequencer_ready

# Select Step with the shared NAV hold+turn context grammar so LEFT_CENTER
# opens the musical property selector instead of the retained Pattern Editor.
150 button NAV down
210 encoder NAV 1
270 button NAV up
650 capture screen step_focus

# Enable the first step so the local range has a visible anchor.
750 tap MACRO_1 60
950 capture screen step_enabled

# Hold LEFT_CENTER to enter the focused Step property selector, then hold
# LEFT_BOTTOM as the local macro-random layer.
1050 button LEFT_CENTER down
1150 capture screen prop_selector_ready
1250 button LEFT_BOTTOM down

# Macro 1 edits step 1 local Pitch random range, because Pitch is active.
1350 encoder MACRO_1 1.00
1500 capture screen macro_local_random_pitch

# Release LEFT_BOTTOM to leave the secondary random layer, then release
# LEFT_CENTER to commit and close the selector overlay.
1650 button LEFT_BOTTOM up
1750 capture screen macro_local_random_still_open
1850 button LEFT_CENTER up
2050 capture screen macro_local_random_closed

# The resolved random preview must persist after the inline edit feedback timeout.
2500 capture screen macro_local_random_persistent
