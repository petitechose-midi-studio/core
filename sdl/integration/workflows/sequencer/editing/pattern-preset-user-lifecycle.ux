# UX workflow: Pattern Preset User save and guarded overwrite.
# Purpose: proves that an authored Pattern Save returns to the musical grid,
# keeps a musician-facing name, and requires the shared guarded hold before an
# existing User asset can be overwritten.
# Expect: capture_changed:pattern_preset_save_new=pattern_preset_saved, capture_changed:pattern_preset_saved=pattern_preset_user_filter, capture_changed:pattern_preset_user_filter=pattern_preset_user_detail, capture_changed:pattern_preset_overwrite_ready=pattern_preset_overwrite_pressed, capture_changed:pattern_preset_overwrite_pressed=pattern_preset_overwrite_armed, capture_changed:pattern_preset_overwrite_armed=pattern_preset_overwritten
# Expect: semantic:pattern_preset_saved:effect=save_pattern_preset
# Expect: semantic:pattern_preset_user_filter:effect=cycle_pattern_preset_source, semantic:pattern_preset_user_filter:property=source_filter, semantic:pattern_preset_user_filter:value_label=user
# Expect: semantic:pattern_preset_user_detail:effect=enter_preset_library_detail, semantic:pattern_preset_user_detail:mode=sequencer.pattern_preset.load.detail, semantic:pattern_preset_user_detail:target=pattern
# Expect: semantic:pattern_preset_overwrite_pressed:effect=save_pattern_preset, semantic:pattern_preset_overwrite_pressed:outcome=pressed, semantic:pattern_preset_overwrite_armed:outcome=armed
# Expect: semantic:pattern_preset_overwritten:effect=save_pattern_preset

0 scenario sequencer

# Enter Pattern Editor, open Pattern Presets and save the current Pattern.
100 tap NAV 60
300 button NAV down
1400 tick
1450 button NAV up
1650 tap BOTTOM_LEFT 60
1850 capture screen pattern_preset_save_new
1950 tap BOTTOM_RIGHT 60
2450 capture screen pattern_preset_saved

# Reopen the library and isolate User assets. The saved asset remains a normal
# inspectable entry instead of a hidden side effect.
2650 tap NAV 60
2850 button NAV down
3950 tick
4000 button NAV up
4200 tap LEFT_CENTER 60
4350 tap LEFT_CENTER 60
4550 capture screen pattern_preset_user_filter
4700 tap NAV 60
4900 capture screen pattern_preset_user_detail
5050 tap LEFT_TOP 60

# Save mode on an existing asset exposes the shared overwrite hold. A tap is
# insufficient; Pressed -> Armed -> committed is visible and deterministic.
5200 tap BOTTOM_LEFT 60
5400 capture screen pattern_preset_overwrite_ready
5500 button BOTTOM_RIGHT down
5650 capture screen pattern_preset_overwrite_pressed
5800 tick
5850 capture screen pattern_preset_overwrite_armed
6700 tick
6750 capture screen pattern_preset_overwritten
6800 button BOTTOM_RIGHT up
