# UX prototype: choose a Track interaction model, then author and navigate one
# compact eight-lane Drum pattern with the same Pattern/Step grammar as the
# melodic sequencer.
# Expect: capture_changed:type_instrument=type_drum, capture_changed:drum_eight_lanes=kick_programmed, capture_changed:kick_programmed=snare_programmed
# Expect: capture_changed:gate_edited=lane_length_seven, capture_changed:pattern_focus=step_focus
# Expect: capture_changed:step_focus=step_two_focused, capture_changed:step_gate_selector=step_velocity_selector
# Expect: capture_changed:overview_velocity_edit=drum_step_editor_state, capture_changed:drum_step_editor_state=drum_step_editor_edited
# Expect: capture_changed:drum_step_editor_edited=overview_after_step_editor, capture_changed:overview_after_step_editor=per_lane_playheads, capture_changed:per_lane_playheads=transport_stopped, capture_changed:transport_stopped=prototype_closed

0 scenario drum-track-ux-prototype
80 capture screen instrument_grid_before_create

# Open Structure > Tracks, select the single +Track slot, and confirm it.
150 button NAV down
210 encoder NAV -1
270 button NAV up
330 tap LEFT_CENTER 60
1280 capture screen structure_tracks_open
1530 encoder NAV 1
1730 capture screen track_2_add_preview
1830 tap NAV 60
2150 capture screen type_instrument

# Select Drum and create Track 2 through the existing atomic transaction.
2300 encoder NAV 1
2500 capture screen type_drum
2650 tap NAV 60
3300 capture screen drum_eight_lanes

# All eight lanes remain visible. Buttons program the selected lane and NAV
# moves vertically while Pattern owns navigation.
3500 tap MACRO_1 60
3700 tap MACRO_5 60
4000 capture screen kick_programmed
4150 encoder NAV 1
4350 tap MACRO_3 60
4550 tap MACRO_7 60
4900 capture screen snare_programmed

# Pattern LEFT_BOTTOM selects the macro property. Velocity is the useful Drum
# default; one NAV detent moves to Gate and release applies it.
5050 button LEFT_BOTTOM down
5250 capture screen velocity_selector
5400 encoder NAV 1
5600 capture screen gate_selector
5700 button LEFT_BOTTOM up
5850 encoder MACRO_3 0.35
6000 encoder MACRO_7 0.85
6250 capture screen gate_edited

# Pattern LEFT_CENTER owns lane dimensions. OPT edits the selected dimension,
# promoting inherited timing to an explicit lane override.
6300 encoder NAV -1
6400 button LEFT_CENTER down
6600 capture screen length_selector
6750 encoder OPT -0.02
6950 capture screen lane_length_seven
7100 encoder NAV 1
7300 capture screen division_selector
7450 encoder OPT -1.60
7650 capture screen lane_division_eighth
7750 button LEFT_CENTER up
7950 capture screen pattern_focus

# NAV press + turn changes context, exactly like the melodic grid. In Step
# focus NAV moves horizontally and OPT edits the focused hit property.
8100 button NAV down
8200 encoder NAV 1
8300 button NAV up
8550 capture screen step_focus
8700 encoder NAV 1
8900 capture screen step_two_focused

# Step LEFT_CENTER selects the hit property. LEFT_BOTTOM is intentionally not
# exposed until the Drum Micro/Cycle content model exists.
9050 button LEFT_CENTER down
9250 capture screen step_gate_selector
9400 encoder NAV -1
9600 capture screen step_velocity_selector
9700 button LEFT_CENTER up
9850 encoder OPT -0.20
10050 capture screen overview_velocity_edit

# A plain NAV press while Step owns navigation opens the shared Step Editor.
# Drum edits stay in the lane model: no Pitch/Chord/Micro/Cycle rows leak in.
10200 tap NAV 60
10500 capture screen drum_step_editor_state
10700 encoder OPT 1.00
10900 encoder NAV 1
11100 encoder OPT 0.55
11300 encoder NAV 1
11500 encoder OPT 0.90
11700 encoder NAV 1
11900 encoder OPT 0.30
12100 encoder NAV 1
12300 encoder OPT 0.70
12600 capture screen drum_step_editor_edited

# Closing the editor returns to the same Drum overview. Its compact geometry
# reflects Velocity height, Gate width, Nudge offset and Chance marker.
12800 tap LEFT_TOP 60
13100 capture screen overview_after_step_editor

# Runtime publishes one independent position per lane. Stop removes the
# playheads without changing authored hits.
13300 tap BOTTOM_CENTER 60
13800 capture screen per_lane_playheads
14000 tap BOTTOM_CENTER 60
14300 capture screen transport_stopped

14500 tap LEFT_TOP 60
14800 capture screen prototype_closed
