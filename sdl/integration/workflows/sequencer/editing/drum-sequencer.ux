# Drum Sequencer acceptance path: typed creation, Track/Pattern/Step grammar,
# lane editing, shared Step Editor, advanced rhythmic content and return.
# Expect: capture_changed:type_drum=kit_empty, capture_changed:kit_empty=kit_general_midi, capture_changed:kit_general_midi=pattern_overview
# Expect: capture_changed:pattern_overview=kick_programmed, capture_changed:kick_programmed=snare_programmed
# Expect: capture_changed:lane_editor_root=lane_identity_inherited, capture_changed:lane_identity_inherited=lane_identity_keyboard
# Expect: capture_changed:lane_identity_keyboard=lane_identity_override, capture_changed:lane_identity_override=overview_lane_color
# Expect: semantic:lane_editor_root:mode=sequencer.drum_lane_edit, semantic:lane_editor_root:property=preset, semantic:lane_editor_root:draft_active=true, semantic:lane_editor_root:dirty=false
# Expect: semantic:lane_identity_inherited:mode=sequencer.drum_lane_edit.identity, semantic:lane_identity_inherited:property=name, semantic:lane_identity_inherited:effect=enter_drum_lane_identity
# Expect: semantic:lane_identity_keyboard:property=name, semantic:lane_identity_keyboard:effect=enter_drum_lane_text_edit
# Expect: semantic:lane_identity_override:property=color, semantic:lane_identity_override:effect=edit_drum_lane_draft, semantic:lane_identity_override:intent=edit_value, semantic:lane_identity_override:dirty=true
# Expect: semantic:overview_lane_color:effect=apply_drum_lane_draft, semantic:overview_lane_color:intent=apply, semantic:overview_lane_color:draft_active=false, semantic:overview_lane_color:published=true, semantic:overview_lane_color:projection=published
# Expect: capture_changed:overview_lane_color=lane_identity_reset_action, capture_changed:lane_identity_reset_action=lane_identity_reset
# Expect: capture_changed:lane_identity_reset=lane_editor_root_after_reset, capture_changed:lane_editor_root_after_reset=overview_lane_reset
# Expect: semantic:lane_identity_reset_action:property=preset_defaults, semantic:lane_identity_reset:effect=reset_drum_lane_identity, semantic:lane_identity_reset:dirty=true
# Expect: semantic:lane_editor_root_after_reset:property=identity, semantic:lane_editor_root_after_reset:effect=leave_drum_lane_identity
# Expect: semantic:pattern_overview:view=sequencer, semantic:pattern_overview:overlay=none, semantic:pattern_overview:shared_track=1
# Expect: semantic:step_focus:mode=sequencer.step, semantic:step_focus:target=step, semantic:step_focus:target_index=0
# Expect: semantic:per_lane_playheads:playing=true, semantic:per_lane_playheads:effect=transport_start
# Expect: capture_changed:step_focus=step_two_focused, capture_changed:step_editor_state=micro_action, capture_changed:micro_action=micro_child
# Expect: capture_changed:micro_child=micro_child_edited, capture_changed:advanced_root=overview_advanced_marker
# Expect: capture_changed:overview_advanced_marker=cycle_action, capture_changed:cycle_action=cycle_child
# Expect: capture_changed:cycle_child=cycle_child_edited, capture_changed:cycle_root=overview_cycle_marker
# Expect: capture_changed:overview_cycle_marker=per_lane_playheads, capture_changed:per_lane_playheads=transport_stopped

0 scenario drum-sequencer
80 capture screen instrument_grid_before_create

# Open Structure > Tracks, select the first add slot and open typed creation.
150 button NAV down
210 encoder NAV -1
270 button NAV up
330 tap LEFT_CENTER 60
1280 capture screen structure_tracks_open
1530 encoder NAV 1
1730 capture screen track_2_add_preview
1830 tap NAV 60
2150 capture screen type_instrument

# Drum creation is deliberately two-stage: choose Track kind, then either a
# blank kit or an optional routing preset. General MIDI gives this scenario
# eight immediately playable lanes while New kit remains the product default.
2300 encoder NAV 1
2500 capture screen type_drum
2650 tap NAV 60
2950 capture screen kit_empty
3100 encoder NAV 1
3300 capture screen kit_general_midi
3450 tap NAV 60
4200 capture screen pattern_overview

# The new Drum Track enters Pattern focus. NAV changes lane and the eight
# macro buttons author visible hits without opening another screen.
4350 tap MACRO_1 60
4550 tap MACRO_5 60
4850 capture screen kick_programmed
5000 encoder NAV 1
5150 tap MACRO_3 60
5350 tap MACRO_7 60
5650 capture screen snare_programmed

# A short NAV at Pattern opens the compact root. Identity is an explicit child;
# Name reuses the shared keyboard and Color remains a draft until Apply.
5800 tap NAV 60
6150 capture screen lane_editor_root
6300 encoder NAV 1
6450 encoder NAV 1
6600 tap NAV 60
6900 capture screen lane_identity_inherited
7050 tap NAV 60
7350 capture screen lane_identity_keyboard
7500 tap LEFT_TOP 60
7650 encoder NAV 1
7800 encoder NAV 1
8000 encoder OPT 0.75
8300 capture screen lane_identity_override
8450 tap BOTTOM_RIGHT 60
8850 capture screen overview_lane_color

# Reopening Identity exposes one atomic reset. Back returns to the root without
# discarding the draft; Apply then publishes the reset as one transaction.
9000 tap NAV 60
9150 encoder NAV 1
9300 encoder NAV 1
9450 tap NAV 60
9600 encoder NAV -1
9900 capture screen lane_identity_reset_action
10050 tap NAV 60
10350 capture screen lane_identity_reset
10500 tap LEFT_TOP 60
10800 capture screen lane_editor_root_after_reset
10950 tap BOTTOM_RIGHT 60
11350 capture screen overview_lane_reset

# One context turn enters Step focus. NAV now moves horizontally and a
# short press opens the same shared Step Editor as the melodic sequencer.
11550 button NAV down
11650 encoder NAV 1
11750 button NAV up
12100 capture screen step_focus
12250 encoder NAV 1
12400 tap MACRO_2 60
12650 capture screen step_two_focused
12800 tap NAV 60
13200 capture screen step_editor_state

# Root Drum rows are State, Chance, Velocity, Gate, Nudge, Micro and Cycle:
# fixed lane pitch means Pitch/Chord are intentionally absent.
13350 encoder NAV 1
13550 encoder OPT 0.70
13750 encoder NAV 1
13950 encoder OPT 0.85
14150 encoder NAV 1
14350 encoder OPT 0.45
14550 encoder NAV 1
14750 encoder OPT 0.65
14950 encoder NAV 1
15200 capture screen micro_action

# Create a MicroSequence through NAV. The shared editor remains open inside
# the child, still exposes the compact rhythm rows and keeps the lane note.
15350 tap NAV 60
15900 capture screen micro_child
16100 encoder NAV 1
16300 encoder NAV 1
16500 encoder OPT 0.55
16800 capture screen micro_child_edited

# Back exposes the explicit dirty-draft decision. NAV validates the default
# Save choice, ascends one graph level, then Back closes the root editor.
# Returning to the overview preserves the scalar geometry and Micro badge.
17000 tap LEFT_TOP 60
17300 tap NAV 60
17700 capture screen advanced_root
17900 tap LEFT_TOP 60
18300 capture screen overview_advanced_marker

# Re-open the same root Step and enter Cycle through the adjacent shared row.
# The child uses the same Drum-lane presentation as Micro: fixed lane pitch,
# compact rhythm geometry and no melodic Pitch/Chord detour.
18500 button NAV down
18600 encoder NAV 1
18700 button NAV up
19000 tap NAV 60
19300 encoder NAV 1
19450 encoder NAV 1
19600 encoder NAV 1
19750 encoder NAV 1
19900 encoder NAV 1
20050 encoder NAV 1
20300 capture screen cycle_action
20450 tap NAV 60
21100 capture screen cycle_child
21250 tap MACRO_2 60
21600 capture screen cycle_child_edited
21800 tap LEFT_TOP 60
22100 tap NAV 60
22500 capture screen cycle_root
22700 tap LEFT_TOP 60
23100 capture screen overview_cycle_marker

# Runtime publishes an independent continuous playhead for every lane.
23300 tap BOTTOM_CENTER 60
24000 capture screen per_lane_playheads
24200 tap BOTTOM_CENTER 60
24500 capture screen transport_stopped
