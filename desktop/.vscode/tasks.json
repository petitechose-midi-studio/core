{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Zig+Ninja)",
            "type": "shell",
            "command": "bash",
            "args": ["build.sh", "Debug"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Fast build with Zig + Ninja"
        },
        {
            "label": "Build Release",
            "type": "shell",
            "command": "bash",
            "args": ["build.sh", "Release"],
            "problemMatcher": ["$gcc"],
            "detail": "Optimized release build"
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "bash",
            "args": ["run.sh"],
            "problemMatcher": [],
            "detail": "Build and run the app"
        },
        {
            "label": "Watch (auto-rebuild)",
            "type": "shell",
            "command": "bash",
            "args": ["watch.sh", "Debug"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Change detected",
                    "endsPattern": "^Watching for changes"
                }
            },
            "detail": "Watch files and auto-rebuild on changes"
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "build", "bin"],
            "problemMatcher": [],
            "detail": "Remove build artifacts"
        }
    ]
}
