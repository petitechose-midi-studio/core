{
  "name": "petitechose-midi-studio-core",
  "version": "1.0.0-beta.2",
  "description": "MIDI Studio Core Framework - Event-driven MIDI controller framework for Teensy 4.1 with LVGL UI",
  "keywords": [
    "midi",
    "teensy",
    "framework",
    "lvgl",
    "controller",
    "audio",
    "music-production"
  ],
  "authors": [
    {
      "name": "petitechose.audio",
      "url": "https://github.com/petitechose-midi-studio"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/petitechose-midi-studio/core.git"
  },
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://github.com/petitechose-midi-studio/core",
  "frameworks": ["arduino"],
  "platforms": ["teensy"],
  "dependencies": {
    "vindar/ILI9341_T4": "^1.6.0",
    "lvgl/lvgl": "^9.4.0",
    "luni64/EncoderTool": "*"
  },
  "export": {
    "include": [
      "src",
      "src/ui/shared",
      "asset",
      "script"
    ],
    "exclude": [
      "examples",
      ".git",
      ".gitignore"
    ]
  },
  "build": {
    "extraScript": "script/pio/lib_pre_build.py",
    "includeDir": "src",
    "flags": [
      "-I src/core",
      "-I src/config/ui",
      "-I src/ui/shared",
      "-D USB_MIDI_SERIAL",
      "-D TEENSY_OPT_SMALLEST_CODE",
      "-D LV_CONF_INCLUDE_SIMPLE",
      "-D LV_LVGL_H_INCLUDE_SIMPLE"
    ],
    "srcFilter": [
      "+<*.c>",
      "+<*.cpp>",
      "+<**/*.c>",
      "+<**/*.cpp>",
      "-<main.cpp>"
    ]
  }
}
